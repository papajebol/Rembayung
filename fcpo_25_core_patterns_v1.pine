//@version=6
indicator("FCPO 25 Core Chart Pattern Detector V1", overlay=true, max_bars_back=1000, max_labels_count=300, max_lines_count=300)

// Inputs ----------------------------------------------------------------------
string G_PIV="Structure", G_ATR="ATR normalization", G_TR="Prior trend", G_BR="Breakout / quality", G_OUT="Output", G_F="Families"
int left=input.int(3,"Pivot left bars",1,20,group=G_PIV), right=input.int(3,"Pivot right bars",1,20,group=G_PIV)
int maxP=input.int(40,"Maximum stored pivots",12,100,group=G_PIV), maxAge=input.int(180,"Candidate maximum age",20,600,group=G_PIV), maxActive=input.int(30,"Maximum active candidates",5,80,group=G_PIV)
int atrLen=input.int(14,"ATR length",2,100,group=G_ATR), minTicks=input.int(2,"Minimum tolerance ticks",1,20,group=G_ATR)
float atrMult=input.float(.20,"ATR tolerance multiplier",.01,2,step=.01,group=G_ATR), maxTolATR=input.float(.40,"Maximum tolerance ATR",.05,3,step=.05,group=G_ATR)
int fastLen=input.int(20,"Fast EMA",2,200,group=G_TR), slowLen=input.int(50,"Slow EMA",3,400,group=G_TR), trendWin=input.int(30,"Pre-pattern slope window",10,200,group=G_TR)
float slopeThr=input.float(.035,"Normalized slope threshold",.001,.5,step=.001,group=G_TR)
int upScore=input.int(3,"Uptrend score threshold",1,4,group=G_TR), downScore=input.int(-3,"Downtrend score threshold",-4,-1,group=G_TR), minTrend=input.int(55,"Minimum trend strength",0,100,group=G_TR)
float breakoutMult=input.float(.05,"Breakout ATR multiplier",0,1,step=.01,group=G_BR), minPoleATR=input.float(2,"Minimum pole ATR",.5,10,step=.25,group=G_BR)
float minR2=input.float(.60,"Minimum curve R²",0,1,step=.05,group=G_BR), minQuality=input.int(60,"Minimum pattern quality",0,100,group=G_BR), maxFlagRatio=input.float(.55,"Maximum flag/pole ratio",.1,1,step=.05,group=G_BR)
bool requireClose=input.bool(true,"Require breakout close",group=G_BR), useBreakStrength=input.bool(false,"Filter weak breakouts",group=G_BR), minBreakATR=input.float(.10,"Minimum breakout strength ATR",0,2,step=.05,group=G_BR), allowVCup=input.bool(false,"Allow V-like cups",group=G_BR)
bool showForming=input.bool(false,"Show forming patterns",group=G_OUT), showConfirmed=input.bool(true,"Show confirmed patterns",group=G_OUT), showLow=input.bool(false,"Show low-quality patterns",group=G_OUT)
bool showLines=input.bool(true,"Show pattern lines",group=G_OUT), showNeck=input.bool(true,"Show neckline",group=G_OUT), showBreak=input.bool(true,"Show breakout level",group=G_OUT), showLabels=input.bool(true,"Show labels",group=G_OUT), showDash=input.bool(true,"Show dashboard",group=G_OUT), debugMode=input.bool(false,"Debug mode",group=G_OUT)
bool fDouble=input.bool(true,"Detect Double Patterns",group=G_F), fTriple=input.bool(true,"Detect Triple Patterns",group=G_F), fHns=input.bool(true,"Detect H&S",group=G_F), fRound=input.bool(true,"Detect Rounding Patterns",group=G_F), fDiamond=input.bool(true,"Detect Diamonds",group=G_F), fV=input.bool(true,"Detect V Patterns",group=G_F), fMega=input.bool(true,"Detect Megaphones",group=G_F), fBump=input.bool(true,"Detect Bump and Run",group=G_F), fWedge=input.bool(true,"Detect Wedges",group=G_F), fTri=input.bool(true,"Detect Triangles",group=G_F), fFlag=input.bool(true,"Detect Flags",group=G_F), fPennant=input.bool(true,"Detect Pennants",group=G_F), fRect=input.bool(true,"Detect Rectangles",group=G_F), fCup=input.bool(true,"Detect Cup and Handle",group=G_F)

// Normalized series and historical trend state --------------------------------
float atr=ta.atr(atrLen), tol=math.max(syminfo.mintick*minTicks,math.min(atr*atrMult,atr*maxTolATR)), buffer=atr*breakoutMult
float fast=ta.ema(close,fastLen), slow=ta.ema(close,slowLen)
float reg=ta.linreg(close,trendWin,0), regPrev=ta.linreg(close,trendWin,1), nSlope=(reg-regPrev)/math.max(atr,syminfo.mintick)
var array<int> pType=array.new_int()
var array<float> pPrice=array.new_float()
var array<int> pBar=array.new_int()
var array<float> pAtr=array.new_float()

f_p(int back)=>array.get(pPrice,array.size(pPrice)-1-back)
f_b(int back)=>array.get(pBar,array.size(pBar)-1-back)
f_t(int back)=>array.get(pType,array.size(pType)-1-back)
f_eq(float a,float b,float at)=>math.abs(a-b)<=math.max(syminfo.mintick*minTicks,math.min(at*atrMult,at*maxTolATR))
f_ns(float a,float b,int ba,int bb,float at)=>(b-a)/math.max(at,syminfo.mintick)/math.max(bb-ba,1)
f_clamp(float x)=>math.max(0,math.min(100,x))

// Structure evidence only uses pivots already confirmed at this bar. Historical
// arrays below freeze the combined state, allowing retrieval before startBar.
float sh1=na, sh2=na, sl1=na, sl2=na
int hc=0, lc=0
if array.size(pType)>0
    for z=0 to math.min(array.size(pType)-1,11)
        if f_t(z)==1 and hc<2
            if hc==0
                sh1:=f_p(z)
            else
                sh2:=f_p(z)
            hc+=1
        if f_t(z)==-1 and lc<2
            if lc==0
                sl1:=f_p(z)
            else
                sl2:=f_p(z)
            lc+=1
int structure=not na(sh2) and not na(sl2)?(sh1>sh2 and sl1>sl2?2:sh1<sh2 and sl1<sl2?-2:0):0
int slopeScore=nSlope>slopeThr?1:nSlope< -slopeThr?-1:0
float emaNS=(fast-fast[3])/math.max(atr,syminfo.mintick)/3
int emaScore=fast>slow and emaNS>slopeThr*.25?1:fast<slow and emaNS< -slopeThr*.25?-1:0
int trendScore=structure+slopeScore+emaScore
int trendState=trendScore>=upScore?1:trendScore<=downScore?-1:0
float trendStrength=f_clamp(math.abs(trendScore)/4*70+math.min(math.abs(nSlope)/slopeThr,2)*15)

// Candidate result model: parallel arrays are more reliable than nested UDTs.
var array<string> cName=array.new_string()
var array<string> cCode=array.new_string()
var array<int> cStart=array.new_int()
var array<int> cEnd=array.new_int()
var array<int> cStatus=array.new_int()
var array<int> cExpected=array.new_int()
var array<int> cPrior=array.new_int()
var array<float> cTrend=array.new_float()
var array<float> cLevel=array.new_float()
var array<float> cInvalid=array.new_float()
var array<float> cGeom=array.new_float()
var array<string> cSig=array.new_string()
var array<string> emitted=array.new_string()
var array<label> labels=array.new_label()
var array<line> lines=array.new_line()
var int serial=0, activeCount=0
var string latestName="—", latestClass="—", latestStatus="—", latestTrend="—", latestID="—"
var float latestQuality=na, latestLevel=na, latestATR=na, latestStrength=na

f_prior(int start)=>
    int off=bar_index-start+1
    int st=off>=0 and off<=999?trendState[off]:0
    float strength=off>=0 and off<=999?trendStrength[off]:0
    [st,strength]
f_trendName(int t)=>t==1?"UP":t==-1?"DOWN":"SIDEWAYS"
f_class(int prior,int dir,string name)=>
    bool bilateral=str.contains(name,"Triangle") or name=="Rectangle" or str.contains(name,"Megaphone")
    dir==1?(prior==-1?"BULLISH_REVERSAL":prior==1?"BULLISH_CONTINUATION":bilateral?"BULLISH_BREAKOUT":"BULLISH_BREAKOUT"):(prior==1?"BEARISH_REVERSAL":prior==-1?"BEARISH_CONTINUATION":bilateral?"BEARISH_BREAKOUT":"BEARISH_BREAKOUT")
f_required(string name)=>str.contains(name,"Top") or str.contains(name,"Bottom") or str.contains(name,"Shoulders") or str.contains(name,"Bump") or str.contains(name,"Cup")
f_contextOK(string name,int prior,float strength)=>
    int need=str.contains(name,"Top") or name=="Head and Shoulders" or name=="Bump and Run Top"?1:str.contains(name,"Bottom") or name=="Inverse Head and Shoulders" or name=="Bump and Run Bottom"?-1:0
    not f_required(name) or (prior==need and strength>=minTrend)
f_signature(string code,int s,int e)=>code+":"+str.tostring(s)+":"+str.tostring(e)

f_offer(string name,string code,int s,int e,int expected,float level,float invalid,float geom,string pivsig)=>
    [prior,strength]=f_prior(s)
    string sig=f_signature(code,s,e)+":"+pivsig
    bool duplicate=false
    if array.size(cSig)>0
        for q=0 to array.size(cSig)-1
            bool same=array.get(cCode,q)==code
            bool overlap=math.min(e,array.get(cEnd,q))-math.max(s,array.get(cStart,q))>=(e-s)*.65
            if same and (array.get(cSig,q)==sig or overlap)
                duplicate:=true
                if geom>array.get(cGeom,q) and array.get(cStatus,q)==0
                    array.set(cGeom,q,geom), array.set(cLevel,q,level), array.set(cInvalid,q,invalid), array.set(cEnd,q,e), array.set(cSig,q,sig)
    bool accepted=not duplicate and f_contextOK(name,prior,strength) and (geom>=minQuality or showLow)
    if accepted
        if array.size(cName)>=maxActive
            array.shift(cName),array.shift(cCode),array.shift(cStart),array.shift(cEnd),array.shift(cStatus),array.shift(cExpected),array.shift(cPrior),array.shift(cTrend),array.shift(cLevel),array.shift(cInvalid),array.shift(cGeom),array.shift(cSig)
        array.push(cName,name),array.push(cCode,code),array.push(cStart,s),array.push(cEnd,e),array.push(cStatus,0),array.push(cExpected,expected),array.push(cPrior,prior),array.push(cTrend,strength),array.push(cLevel,level),array.push(cInvalid,invalid),array.push(cGeom,geom),array.push(cSig,sig)
        if showForming and showLabels
            label lb=label.new(e,level,code+" FORMING\nQ:"+str.tostring(math.round(geom)),style=label.style_label_left,color=color.new(color.orange,25),textcolor=color.white,size=size.tiny)
            array.push(labels,lb)
    if debugMode and not accepted and not duplicate
        label.new(bar_index,high,"REJECT "+code+"\nTrend "+f_trendName(prior)+" "+str.tostring(math.round(strength))+"\nTol "+str.tostring(tol,format.mintick)+" G "+str.tostring(math.round(geom))+"\n"+(not f_contextOK(name,prior,strength)?"context":"quality"),style=label.style_label_down,color=color.new(color.gray,60),textcolor=color.white,size=size.tiny)

// Quadratic fit: evenly sampled closes over a bounded interval. Returns curvature
// sign and R²; this is used instead of reducing rounded structures to 3 pivots.
f_curve(int s,int e)=>
    int n=math.min(e-s+1,80), off=bar_index-e
    float sx=0.,sx2=0.,sx3=0.,sx4=0.,sy=0.,sxy=0.,sx2y=0.
    if n>=7 and off>=0
        for k=0 to n-1
            float x=k, y=close[off+n-1-k]
            sx+=x,sx2+=x*x,sx3+=x*x*x,sx4+=x*x*x*x,sy+=y,sxy+=x*y,sx2y+=x*x*y
    float det=n*(sx2*sx4-sx3*sx3)-sx*(sx*sx4-sx2*sx3)+sx2*(sx*sx3-sx2*sx2)
    float a=math.abs(det)>1e-10?(n*(sx2*sx2y-sx3*sxy)-sx*(sx*sx2y-sx2*sxy)+sy*(sx*sx3-sx2*sx2))/det:0
    float b=math.abs(det)>1e-10?(n*(sxy*sx4-sx2y*sx3)-sy*(sx*sx4-sx2*sx3)+sx2*(sx*sx2y-sxy*sx2))/det:0
    float c=math.abs(det)>1e-10?(sy*(sx2*sx4-sx3*sx3)-sx*(sxy*sx4-sx2y*sx3)+sx2*(sxy*sx3-sx2y*sx2))/det:0
    float mean=n>0?sy/n:0, ss=0.,err=0.
    if n>=7 and off>=0
        for k=0 to n-1
            float y=close[off+n-1-k], fit=a*k*k+b*k+c
            ss+=math.pow(y-mean,2),err+=math.pow(y-fit,2)
    [a,ss>0?1-err/ss:0]

// Geometry engine runs only on a newly confirmed pivot -------------------------
float ph=ta.pivothigh(high,left,right), pl=ta.pivotlow(low,left,right)
bool newPivot=not na(ph) or not na(pl)
if newPivot
    int typ=not na(ph)?1:-1
    float pr=not na(ph)?ph:pl
    int pb=bar_index-right
    // If both occur together, retain the more extreme event deterministically.
    array.push(pType,typ),array.push(pPrice,pr),array.push(pBar,pb),array.push(pAtr,atr[right])
    if array.size(pType)>maxP
        array.shift(pType),array.shift(pPrice),array.shift(pBar),array.shift(pAtr)

if newPivot and array.size(pType)>=5
    int n=array.size(pType), s4=f_b(4), e=f_b(0)
    float a=f_p(4),b=f_p(3),c=f_p(2),d=f_p(1),ee=f_p(0), at=array.get(pAtr,n-1)
    string sig=str.tostring(s4)+","+str.tostring(f_b(3))+","+str.tostring(f_b(2))+","+str.tostring(f_b(1))+","+str.tostring(e)
    float span=math.max(math.abs(c-b),at), sym=f_clamp(100-math.abs((f_b(2)-s4)-(e-f_b(2)))/math.max(e-s4,1)*100)
    // Double / triple levels and neckline.
    if fDouble and f_t(4)==f_t(2) and f_t(2)==f_t(0) and f_eq(c,ee,at)
        bool top=f_t(0)==1
        float q=f_clamp(70+20*(1-math.abs(c-ee)/math.max(tol,syminfo.mintick))+sym*.1)
        f_offer(top?"Double Top":"Double Bottom",top?"DT":"DB",f_b(2),e,top?-1:1,d,top?math.max(c,ee)+tol:math.min(c,ee)-tol,q,sig)
    if fTriple and f_t(4)==f_t(2) and f_t(2)==f_t(0) and f_eq(a,c,at) and f_eq(c,ee,at)
        bool top=f_t(0)==1
        f_offer(top?"Triple Top":"Triple Bottom",top?"TT":"TB",s4,e,top?-1:1,top?math.min(b,d):math.max(b,d),top?math.max(a,math.max(c,ee))+tol:math.min(a,math.min(c,ee))-tol,88,sig)
    // H&S: three alternating peaks/troughs, middle head, similar shoulders.
    if fHns and f_t(4)==f_t(2) and f_t(2)==f_t(0) and f_eq(a,ee,at)
        bool h=f_t(0)==1 and c>a+tol, ih=f_t(0)==-1 and c<a-tol
        if h or ih
            float neck=(b+d)/2
            f_offer(h?"Head and Shoulders":"Inverse Head and Shoulders",h?"HNS":"IHNS",s4,e,h?-1:1,neck,h?c+tol:c-tol,f_clamp(75+sym*.2),sig)
    // Boundary slopes from same-type pivots, always ATR/bar normalized.
    float upper1=f_t(4)==1?a:b, upper2=f_t(0)==1?ee:d, lower1=f_t(4)==-1?a:b, lower2=f_t(0)==-1?ee:d
    int ub1=f_t(4)==1?s4:f_b(3),ub2=f_t(0)==1?e:f_b(1),lb1=f_t(4)==-1?s4:f_b(3),lb2=f_t(0)==-1?e:f_b(1)
    float us=f_ns(upper1,upper2,ub1,ub2,at), ls=f_ns(lower1,lower2,lb1,lb2,at), r0=upper1-lower1,r1=upper2-lower2
    bool contracting=r1<r0 and r1>0, expanding=r1>r0
    float flat=.025, boundaryQ=f_clamp(100-(math.abs(us)+math.abs(ls))*120)
    if fWedge and contracting
        if us>0 and ls>us
            f_offer("Rising Wedge","RW",s4,e,-1,lower2,upper2+tol,f_clamp(72+(r0-r1)/math.max(r0,at)*25),sig)
        if us<0 and ls<0 and us>ls
            f_offer("Falling Wedge","FW",s4,e,1,upper2,lower2-tol,f_clamp(72+(r0-r1)/math.max(r0,at)*25),sig)
    if fTri and contracting
        if math.abs(us)<flat and ls>flat
            f_offer("Ascending Triangle","AT",s4,e,1,upper2,lower2-tol,f_clamp(75+boundaryQ*.15),sig)
        if math.abs(ls)<flat and us< -flat
            f_offer("Descending Triangle","DTR",s4,e,-1,lower2,upper2+tol,f_clamp(75+boundaryQ*.15),sig)
        if us< -flat and ls>flat
            f_offer("Symmetrical Triangle","ST",s4,e,0,(upper2+lower2)/2,na,f_clamp(78+(r0-r1)/math.max(r0,at)*20),sig)
    if fRect and math.abs(us)<flat and math.abs(ls)<flat and f_eq(upper1,upper2,at) and f_eq(lower1,lower2,at)
        f_offer("Rectangle","RECT",s4,e,0,(upper2+lower2)/2,na,f_clamp(82+boundaryQ*.15),sig)
    if fMega and expanding and us>0 and ls<0
        f_offer("Megaphone / Broadening","MEGA",s4,e,0,(upper2+lower2)/2,na,f_clamp(70+(r1-r0)/math.max(r0,at)*20),sig)
    // Strong pole plus small parallel channel (flag) or contraction (pennant).
    int poleStart=s4-math.max(e-s4,5), poleOff=bar_index-poleStart
    float poleMove=poleOff>=0 and poleOff<=999?close[bar_index-e]-close[poleOff]:0, poleATR=math.abs(poleMove)/math.max(at,syminfo.mintick), consRange=ta.highest(high,math.max(bar_index-s4+1,1))-ta.lowest(low,math.max(bar_index-s4+1,1))
    bool small=poleATR>=minPoleATR and consRange<=math.abs(poleMove)*maxFlagRatio
    if fFlag and small and math.abs(us-ls)<.04
        bool bull=poleMove>0 and us<=flat, bear=poleMove<0 and ls>=-flat
        if bull or bear
            f_offer(bull?"Bullish Flag":"Bearish Flag",bull?"BFLAG":"SFLAG",s4,e,bull?1:-1,bull?upper2:lower2,bull?lower2-tol:upper2+tol,f_clamp(70+math.min(poleATR,5)*5+boundaryQ*.1),sig)
    if fPennant and small and contracting and us<0 and ls>0
        bool bull=poleMove>0
        f_offer(bull?"Bullish Pennant":"Bearish Pennant",bull?"BPEN":"SPEN",s4,e,bull?1:-1,bull?upper2:lower2,bull?lower2-tol:upper2+tol,f_clamp(72+math.min(poleATR,5)*5),sig)
    // V requires steep, opposite normalized legs and temporal symmetry.
    if fV
        float leg1=f_ns(a,c,s4,f_b(2),at), leg2=f_ns(c,ee,f_b(2),e,at)
        bool vt=f_t(2)==1 and leg1>slopeThr*3 and leg2< -slopeThr*3, vb=f_t(2)==-1 and leg1< -slopeThr*3 and leg2>slopeThr*3
        if vt or vb
            f_offer(vt?"V-Top":"V-Bottom",vt?"VT":"VB",s4,e,vt?-1:1,vt?math.min(b,d):math.max(b,d),vt?c+tol:c-tol,f_clamp(65+sym*.25+math.min(math.abs(leg1+ -leg2),1)*10),sig)
    // Rounding and cups: quadratic curvature + fit quality.
    if fRound or fCup
        [curve,r2]=f_curve(s4,e)
        bool rt=curve<0 and r2>=minR2, rb=curve>0 and r2>=minR2
        if fRound and (rt or rb)
            f_offer(rt?"Rounding Top":"Rounding Bottom",rt?"RT":"RB",s4,e,rt?-1:1,rt?math.min(b,d):math.max(b,d),rt?c+tol:c-tol,f_clamp(55+r2*40),sig)
        bool rims=f_eq(a,ee,at), rounded=allowVCup or r2>=minR2
        float depth=math.abs(c-(a+ee)/2), handle=math.abs(d-ee)
        if fCup and rims and rounded and depth>at and handle<depth*.5
            bool cup=curve>0 and f_t(2)==-1, inv=curve<0 and f_t(2)==1
            if cup or inv
                f_offer(cup?"Cup and Handle":"Inverted Cup and Handle",cup?"CUP":"ICUP",s4,e,cup?1:-1,(a+ee)/2,cup?c-tol:c+tol,f_clamp(60+r2*30+(1-handle/depth)*10),sig)
    // Bump/run approximation: accelerated middle excursion then lead-in break.
    if fBump
        float lead=f_ns(a,b,s4,f_b(3),at), bump=f_ns(b,c,f_b(3),f_b(2),at)
        bool bt=lead>0 and bump>lead*1.8 and f_t(2)==1, bb=lead<0 and bump<lead*1.8 and f_t(2)==-1
        if bt or bb
            f_offer(bt?"Bump and Run Top":"Bump and Run Bottom",bt?"BRT":"BRB",s4,e,bt?-1:1,bt?d:b,bt?c+tol:c-tol,f_clamp(65+math.min(math.abs(bump-lead),1)*25),sig)

// Six-pivot expand-then-contract diamond approximation.
if newPivot and fDiamond and array.size(pType)>=7
    float rA=math.abs(f_p(5)-f_p(6)),rB=math.abs(f_p(3)-f_p(4)),rC=math.abs(f_p(0)-f_p(1)), at=array.get(pAtr,array.size(pAtr)-1)
    if rB>rA and rC<rB
        int s=f_b(6), e=f_b(0), expected=0
        [pt,pts]=f_prior(s)
        float dq=f_clamp(65+(rB-rA)/math.max(rA,at)*15+(rB-rC)/math.max(rB,at)*20)
        // Reversal and continuation are distinct candidates over the same legal
        // geometry. Their stored pre-pattern context and breakout direction decide.
        if pt==1
            f_offer("Diamond Top","DIA-T",s,e,-1,(f_p(0)+f_p(1))/2,na,dq,str.tostring(s)+":"+str.tostring(e))
            f_offer("Continuation Diamond","DIA-C",s,e,1,(f_p(0)+f_p(1))/2,na,dq,str.tostring(s)+":"+str.tostring(e))
        if pt==-1
            f_offer("Diamond Bottom","DIA-B",s,e,1,(f_p(0)+f_p(1))/2,na,dq,str.tostring(s)+":"+str.tostring(e))
            f_offer("Continuation Diamond","DIA-C",s,e,-1,(f_p(0)+f_p(1))/2,na,dq,str.tostring(s)+":"+str.tostring(e))

// Candidate lifecycle: confirmed-bar breakout, failure, expiry, classification. --
if barstate.isconfirmed and array.size(cName)>0
    activeCount:=0
    for i=0 to array.size(cName)-1
        if array.get(cStatus,i)==0
            int age=bar_index-array.get(cEnd,i), expected=array.get(cExpected,i)
            float level=array.get(cLevel,i), inv=array.get(cInvalid,i), pxUp=requireClose?close:high, pxDn=requireClose?close:low
            // Bilateral candidates use their recent envelope around the stored midlevel.
            float localHi=ta.highest(high,math.min(math.max(age+1,2),50))[1], localLo=ta.lowest(low,math.min(math.max(age+1,2),50))[1]
            float upLevel=expected==0?math.max(level,localHi):level, dnLevel=expected==0?math.min(level,localLo):level
            bool up=pxUp>upLevel+buffer, dn=pxDn<dnLevel-buffer
            int dir=expected==1 and up?1:expected==-1 and dn?-1:expected==0 and up?1:expected==0 and dn?-1:0
            bool invalidated=age>maxAge or (not na(inv) and ((expected==1 and low<inv) or (expected==-1 and high>inv)))
            float bLevel=dir==1?upLevel:dnLevel, bStrength=dir==0?0:math.abs((close-bLevel)/math.max(atr,syminfo.mintick))
            bool strong=not useBreakStrength or bStrength>=minBreakATR
            if dir!=0 and strong
                array.set(cStatus,i,1)
                string key=array.get(cSig,i)+":"+str.tostring(dir)
                bool seen=array.includes(emitted,key)
                if not seen
                    array.push(emitted,key)
                    if array.size(emitted)>100
                        array.shift(emitted)
                    serial+=1
                    float quality=f_clamp(array.get(cGeom,i)*.65+math.min(array.get(cTrend,i),100)*.15+math.min(bStrength*100,100)*.20)
                    string cls=f_class(array.get(cPrior,i),dir,array.get(cName,i)), id=array.get(cCode,i)+"-"+str.tostring(array.get(cStart,i))+"-"+str.tostring(bar_index)
                    latestName:=array.get(cName,i),latestClass:=cls,latestStatus:="CONFIRMED",latestTrend:=f_trendName(array.get(cPrior,i)),latestID:=id,latestQuality:=quality,latestLevel:=bLevel,latestATR:=atr,latestStrength:=array.get(cTrend,i)
                    if showConfirmed and (quality>=minQuality or showLow) and showLabels
                        label lb=label.new(bar_index,dir==1?low:high,array.get(cCode,i)+" #"+str.tostring(serial,"000")+"\n"+str.replace_all(cls,"_"," ")+"\nQ:"+str.tostring(math.round(quality))+" T:"+latestTrend+" "+str.tostring(math.round(latestStrength)),style=dir==1?label.style_label_up:label.style_label_down,color=dir==1?color.new(color.lime,10):color.new(color.red,10),textcolor=color.white,size=size.tiny)
                        array.push(labels,lb)
                    if showLines
                        int so=bar_index-array.get(cStart,i), eo=bar_index-array.get(cEnd,i)
                        if so>=0 and so<=999 and eo>=0 and eo<=999
                            line shapeLine=line.new(array.get(cStart,i),close[so],array.get(cEnd,i),close[eo],color=color.new(dir==1?color.lime:color.red,35))
                            array.push(lines,shapeLine)
                    bool neckPattern=str.contains(array.get(cName,i),"Top") or str.contains(array.get(cName,i),"Bottom") or str.contains(array.get(cName,i),"Shoulders")
                    if showNeck and neckPattern
                        line neckLine=line.new(array.get(cEnd,i),bLevel,bar_index,bLevel,color=color.new(color.yellow,20))
                        array.push(lines,neckLine)
                    if showBreak
                        line ln=line.new(array.get(cEnd,i),bLevel,bar_index,bLevel,color=dir==1?color.lime:color.red,style=line.style_dashed)
                        array.push(lines,ln)
            else if invalidated
                array.set(cStatus,i,2)
                if debugMode
                    label.new(bar_index,close,array.get(cCode,i)+" FAILED\n"+(age>maxAge?"expired":"invalidated"),color=color.new(color.red,55),textcolor=color.white,size=size.tiny)
            else
                activeCount+=1
while array.size(labels)>120
    label.delete(array.shift(labels))
while array.size(lines)>100
    line.delete(array.shift(lines))

// Dashboard -------------------------------------------------------------------
var table dash=table.new(position.top_right,2,10,border_width=1)
if barstate.islast and showDash
    table.cell(dash,0,0,"LATEST PATTERN",bgcolor=color.rgb(35,45,60),text_color=color.white),table.cell(dash,1,0,"",bgcolor=color.rgb(35,45,60))
    table.cell(dash,0,1,"Pattern"),table.cell(dash,1,1,latestName)
    table.cell(dash,0,2,"Class"),table.cell(dash,1,2,str.replace_all(latestClass,"_"," "))
    table.cell(dash,0,3,"Status"),table.cell(dash,1,3,latestStatus)
    table.cell(dash,0,4,"Prior Trend"),table.cell(dash,1,4,latestTrend)
    table.cell(dash,0,5,"Trend Strength"),table.cell(dash,1,5,na(latestStrength)?"—":str.tostring(math.round(latestStrength)))
    table.cell(dash,0,6,"Quality"),table.cell(dash,1,6,na(latestQuality)?"—":str.tostring(math.round(latestQuality)))
    table.cell(dash,0,7,"Breakout / ATR"),table.cell(dash,1,7,na(latestLevel)?"—":str.tostring(latestLevel,format.mintick)+" / "+str.tostring(latestATR,format.mintick))
    table.cell(dash,0,8,"ID"),table.cell(dash,1,8,latestID)
    table.cell(dash,0,9,"Active forming"),table.cell(dash,1,9,str.tostring(activeCount))

alertcondition(latestStatus=="CONFIRMED" and latestID!=latestID[1],"New confirmed pattern","A new FCPO Core Chart Pattern has confirmed.")
