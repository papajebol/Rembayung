//@version=6
indicator("FCPO 25 Core Chart Pattern Detector V1", overlay = true, max_bars_back = 1000, max_labels_count = 300, max_lines_count = 300)

// Constants -------------------------------------------------------------------
int PIVOT_HIGH = 1
int PIVOT_LOW = -1
int TREND_UP = 1
int TREND_DOWN = -1
int TREND_ANY = 0
int BREAK_UP = 1
int BREAK_DOWN = -1
int BREAK_BILATERAL = 0
int STATUS_FORMING = 0
int STATUS_CONFIRMED_INTERNAL = 1
int STATUS_FAILED = 2
int STATUS_CONFIRMED_SUPPRESSED = 3
int STATUS_CONFIRMED_EMITTED = 4
int STATUS_EXPIRED = 5
int MODE_REVERSAL = 1
int MODE_CONTINUATION = 2
int MODE_CONTEXTUAL = 3
int MODE_BILATERAL = 4
int INVALID_NONE = 0
int INVALID_STATIC = 1
int INVALID_OPPOSITE_BOUNDARY = 2

// Inputs ----------------------------------------------------------------------
string G_PIV = "Structure"
string G_ATR = "ATR normalization"
string G_TR = "Prior trend"
string G_BR = "Breakout / quality"
string G_OUT = "Output"
string G_F = "Families"
string G_SEL = "Geometry selectivity"
int left = input.int(3, "Pivot left bars", 1, 20, group = G_PIV)
int right = input.int(3, "Pivot right bars", 1, 20, group = G_PIV)
int maxP = input.int(40, "Maximum stored pivots", 12, 100, group = G_PIV)
int maxAge = input.int(180, "Candidate maximum age", 20, 600, group = G_PIV)
int maxActive = input.int(30, "Maximum active candidates", 5, 80, group = G_PIV)
int atrLen = input.int(14, "ATR length", 2, 100, group = G_ATR)
int minTicks = input.int(2, "Minimum tolerance ticks", 1, 20, group = G_ATR)
float atrMult = input.float(0.20, "ATR tolerance multiplier", 0.01, 2.0, step = 0.01, group = G_ATR)
float maxTolATR = input.float(0.40, "Maximum tolerance ATR", 0.05, 3.0, step = 0.05, group = G_ATR)
int fastLen = input.int(20, "Fast EMA", 2, 200, group = G_TR)
int slowLen = input.int(50, "Slow EMA", 3, 400, group = G_TR)
int trendWin = input.int(30, "Pre-pattern slope window", 10, 200, group = G_TR)
float slopeThr = input.float(0.035, "Normalized slope threshold", 0.001, 0.5, step = 0.001, group = G_TR)
int upScore = input.int(3, "Uptrend score threshold", 1, 4, group = G_TR)
int downScore = input.int(-3, "Downtrend score threshold", -4, -1, group = G_TR)
int minTrend = input.int(55, "Minimum trend strength", 0, 100, group = G_TR)
float breakoutMult = input.float(0.05, "Breakout ATR multiplier", 0.0, 1.0, step = 0.01, group = G_BR)
float minPoleATR = input.float(2.0, "Minimum pole ATR", 0.5, 10.0, step = 0.25, group = G_BR)
float accelerationMultiplier = input.float(1.8, "Bump acceleration multiplier", 1.1, 5.0, step = 0.1, group = G_BR)
float minR2 = input.float(0.60, "Minimum curve R²", 0.0, 1.0, step = 0.05, group = G_BR)
float vSymmetryMin = input.float(0.55, "Minimum V temporal symmetry", 0.1, 1.0, step = 0.05, group = G_BR)
int minGeometryScore = input.int(55, "Minimum geometry score", 0, 100, group = G_BR)
int minFinalQuality = input.int(60, "Minimum final quality", 0, 100, group = G_BR)
float maxFlagRatio = input.float(0.55, "Maximum flag/pole ratio", 0.1, 1.0, step = 0.05, group = G_BR)
bool requireClose = input.bool(true, "Require breakout close", group = G_BR)
bool useBreakStrength = input.bool(false, "Filter weak breakouts", group = G_BR)
float minBreakATR = input.float(0.10, "Minimum breakout strength ATR", 0.0, 2.0, step = 0.05, group = G_BR)
bool relaxCupCurveFit = input.bool(false, "Relax Cup Curve Fit", group = G_BR)
string invalidationMode = input.string("Wick", "Invalidation Mode", options = ["Wick", "Close"], group = G_BR)
bool showForming = input.bool(false, "Show forming patterns", group = G_OUT)
bool showConfirmed = input.bool(true, "Show confirmed labels", group = G_OUT)
bool showLow = input.bool(false, "Show low-quality patterns", group = G_OUT)
bool showLines = input.bool(true, "Show pattern lines", group = G_OUT)
bool showNeck = input.bool(true, "Show neckline", group = G_OUT)
bool showBreak = input.bool(true, "Show breakout level", group = G_OUT)
bool showLabels = input.bool(true, "Show labels", group = G_OUT)
bool showDash = input.bool(true, "Show dashboard", group = G_OUT)
bool debugMode = input.bool(false, "Debug mode", group = G_OUT)
bool fDouble = input.bool(true, "Detect Double Patterns", group = G_F)
bool fTriple = input.bool(true, "Detect Triple Patterns", group = G_F)
bool fHns = input.bool(true, "Detect H&S", group = G_F)
bool fRound = input.bool(true, "Detect Rounding Patterns", group = G_F)
bool fDiamond = input.bool(true, "Detect Diamonds", group = G_F)
bool fV = input.bool(true, "Detect V Patterns", group = G_F)
bool fMega = input.bool(true, "Detect Megaphones", group = G_F)
bool fBump = input.bool(true, "Detect Bump and Run", group = G_F)
bool fWedge = input.bool(true, "Detect Wedges", group = G_F)
bool fTri = input.bool(true, "Detect Triangles", group = G_F)
bool fFlag = input.bool(true, "Detect Flags", group = G_F)
bool fPennant = input.bool(true, "Detect Pennants", group = G_F)
bool fRect = input.bool(true, "Detect Rectangles", group = G_F)
bool fCup = input.bool(true, "Detect Cup and Handle", group = G_F)
int minPriorTrendBars = input.int(10, "Minimum prior-trend bars", 3, 100, group = G_SEL)
int minWedgeBars = input.int(8, "Minimum wedge bars", 4, 100, group = G_SEL)
float minWedgeStartWidthATR = input.float(1.0, "Minimum wedge start width ATR", 0.25, 10.0, step = 0.25, group = G_SEL)
float minWedgeContractionRatio = input.float(0.20, "Minimum wedge contraction ratio", 0.05, 0.90, step = 0.05, group = G_SEL)
float maxApexDistanceMultiple = input.float(3.0, "Maximum wedge apex distance multiple", 0.5, 10.0, step = 0.5, group = G_SEL)
int minTriangleBars = input.int(8, "Minimum triangle bars", 4, 100, group = G_SEL)
float minTriangleStartWidthATR = input.float(1.0, "Minimum triangle start width ATR", 0.25, 10.0, step = 0.25, group = G_SEL)
float minTriangleContractionRatio = input.float(0.20, "Minimum triangle contraction ratio", 0.05, 0.90, step = 0.05, group = G_SEL)
int minRectangleBars = input.int(8, "Minimum rectangle bars", 4, 100, group = G_SEL)
float minRectangleHeightATR = input.float(0.75, "Minimum rectangle height ATR", 0.25, 10.0, step = 0.25, group = G_SEL)
float minMegaphoneExpansionRatio = input.float(0.20, "Minimum megaphone expansion ratio", 0.05, 2.0, step = 0.05, group = G_SEL)
int minMegaphoneBars = input.int(8, "Minimum megaphone bars", 4, 100, group = G_SEL)
float minMegaphoneStartWidthATR = input.float(0.75, "Minimum megaphone start width ATR", 0.25, 10.0, step = 0.25, group = G_SEL)
int minFlagBars = input.int(6, "Minimum flag bars", 3, 100, group = G_SEL)
int maxFlagBars = input.int(40, "Maximum flag bars", 6, 200, group = G_SEL)
int minPennantBars = input.int(6, "Minimum pennant bars", 3, 100, group = G_SEL)
int maxPennantBars = input.int(40, "Maximum pennant bars", 6, 200, group = G_SEL)
float minVLegATR = input.float(1.0, "Minimum V leg ATR", 0.25, 10.0, step = 0.25, group = G_SEL)
float headProminenceATR = input.float(0.75, "Minimum H&S head prominence ATR", 0.25, 10.0, step = 0.25, group = G_SEL)
float minDoubleDepthATR = input.float(0.75, "Minimum double/triple depth ATR", 0.25, 10.0, step = 0.25, group = G_SEL)
float minRoundingHeightATR = input.float(1.0, "Minimum rounding height ATR", 0.25, 10.0, step = 0.25, group = G_SEL)
float minRoundingCenterEdgeATR = input.float(0.25, "Minimum rounding center-edge ATR", 0.05, 2.0, step = 0.05, group = G_SEL)
float vertexMinFraction = input.float(0.25, "Minimum rounding vertex fraction", 0.05, 0.45, step = 0.05, group = G_SEL)
float vertexMaxFraction = input.float(0.75, "Maximum rounding vertex fraction", 0.55, 0.95, step = 0.05, group = G_SEL)
float maxHandleDepthRatio = input.float(0.40, "Maximum cup handle depth ratio", 0.10, 0.80, step = 0.05, group = G_SEL)
float minPennantContractionRatio = input.float(0.20, "Minimum pennant contraction ratio", 0.05, 0.90, step = 0.05, group = G_SEL)
float minPennantStartWidthATR = input.float(0.75, "Minimum pennant start width ATR", 0.25, 10.0, step = 0.25, group = G_SEL)
float minFlagRangeATR = input.float(0.50, "Minimum flag range ATR", 0.10, 5.0, step = 0.10, group = G_SEL)
int minDoubleSeparationBars = input.int(4, "Minimum double separation bars", 1, 100, group = G_SEL)
int maxDoubleSeparationBars = input.int(60, "Maximum double separation bars", 4, 300, group = G_SEL)
int minTripleLegBars = input.int(3, "Minimum triple leg bars", 1, 100, group = G_SEL)
int maxTripleSpanBars = input.int(90, "Maximum triple span bars", 6, 400, group = G_SEL)
float maxFlagWidthChangeRatio = input.float(0.35, "Maximum flag width change ratio", 0.05, 1.0, step = 0.05, group = G_SEL)
int minDiamondBars = input.int(10, "Minimum diamond bars", 6, 200, group = G_SEL)
float minDiamondMaxWidthATR = input.float(1.25, "Minimum diamond maximum width ATR", 0.25, 10.0, step = 0.25, group = G_SEL)
int minHandleBars = input.int(3, "Minimum Cup handle bars", 1, 50, group = G_SEL)
float maxHandleDurationRatio = input.float(0.50, "Maximum Cup handle duration ratio", 0.10, 2.0, step = 0.10, group = G_SEL)
float diamondBoundaryToleranceATR = input.float(0.30, "Diamond boundary tolerance ATR", 0.05, 1.0, step = 0.05, group = G_SEL)
float displayClusterOverlap = input.float(0.55, "Display cluster overlap", 0.10, 1.0, step = 0.05, group = G_OUT)
int displayClusterBreakoutBars = input.int(8, "Display cluster breakout bars", 1, 50, group = G_OUT)
string drawingMode = input.string("Latest Only", "Drawing Mode", options = ["Latest Only", "Last N", "All (max 50)"], group = G_OUT)
int lastNPatterns = input.int(5, "Last N patterns", 1, 20, group = G_OUT)

// Shared normalized primitives ------------------------------------------------
float atr = ta.atr(atrLen)
float levelTolerance = math.max(syminfo.mintick * minTicks, math.min(atr * atrMult, atr * maxTolATR))
float breakoutBuffer = atr * breakoutMult
float fast = ta.ema(close, fastLen)
float slow = ta.ema(close, slowLen)
float regression = ta.linreg(close, trendWin, 0)
float regressionPrevious = ta.linreg(close, trendWin, 1)
float normalizedTrendSlope = (regression - regressionPrevious) / math.max(atr, syminfo.mintick)

f_clamp(float value) =>
    math.max(0.0, math.min(100.0, value))

f_tolerance(float atrValue) =>
    math.max(syminfo.mintick * minTicks, math.min(atrValue * atrMult, atrValue * maxTolATR))

f_equalLevel(float first, float second, float atrValue) =>
    not na(first) and not na(second) and math.abs(first - second) <= f_tolerance(atrValue)

f_normalizedSlope(float firstPrice, float secondPrice, int firstBar, int secondBar, float atrValue) =>
    float result = na
    if not na(firstPrice) and not na(secondPrice) and secondBar != firstBar and not na(atrValue)
        result := (secondPrice - firstPrice) / math.max(atrValue, syminfo.mintick) / (secondBar - firstBar)
    result

// A single boundary projection primitive is used by every static and sloping
// breakout. Equal-bar anchors safely reduce to the second anchor price.
f_lineValueAt(int firstBar, float firstPrice, int secondBar, float secondPrice, int targetBar) =>
    float result = na
    if not na(firstPrice) and not na(secondPrice)
        result := secondBar == firstBar ? secondPrice : firstPrice + (secondPrice - firstPrice) / (secondBar - firstBar) * (targetBar - firstBar)
    result

f_expiresAtBoundaryCross(string code) =>
    code == "RW" or code == "FW" or code == "AT" or code == "DTR" or code == "ST" or code == "BPEN" or code == "SPEN"

// Audits every bar that elapsed after the final pattern pivot but before the
// candidate became knowable. Breakouts in this gap are deliberately ignored;
// only structural invalidation prevents candidate creation.
f_confirmationGapInvalidated(bool auditEnabled, int endBar, int expectedBreakout, int candidateInvalidMode, float invalidLevel, int upperBar1, float upperPrice1, int upperBar2, float upperPrice2, int lowerBar1, float lowerPrice1, int lowerBar2, float lowerPrice2) =>
    bool invalidated = false
    bool historyAvailable = not auditEnabled or bar_index >= endBar and bar_index - endBar <= 999
    string reason = ""
    if auditEnabled and historyAvailable and endBar < bar_index
        for gapBar = endBar + 1 to bar_index
            int gapOffset = bar_index - gapBar
            float invalidationLow = invalidationMode == "Wick" ? low[gapOffset] : close[gapOffset]
            float invalidationHigh = invalidationMode == "Wick" ? high[gapOffset] : close[gapOffset]
            float gapATR = atr[gapOffset]
            float gapBuffer = gapATR * breakoutMult
            if na(invalidationLow) or na(invalidationHigh) or na(gapATR)
                historyAvailable := false
            else if not invalidated
                if candidateInvalidMode == INVALID_STATIC and not na(invalidLevel)
                    invalidated := expectedBreakout == BREAK_UP ? invalidationLow < invalidLevel : expectedBreakout == BREAK_DOWN ? invalidationHigh > invalidLevel : false
                    reason := invalidated ? "confirmation-gap invalidation" : reason
                else if candidateInvalidMode == INVALID_OPPOSITE_BOUNDARY
                    float gapUpper = f_lineValueAt(upperBar1, upperPrice1, upperBar2, upperPrice2, gapBar)
                    float gapLower = f_lineValueAt(lowerBar1, lowerPrice1, lowerBar2, lowerPrice2, gapBar)
                    if na(gapUpper) or na(gapLower)
                        historyAvailable := false
                    else
                        invalidated := expectedBreakout == BREAK_UP ? invalidationLow < gapLower - gapBuffer : expectedBreakout == BREAK_DOWN ? invalidationHigh > gapUpper + gapBuffer : false
                        reason := invalidated ? "confirmation-gap opposite-boundary break" : reason
    [invalidated, historyAvailable, reason]

f_overlapRatio(int firstStart, int firstEnd, int secondStart, int secondEnd) =>
    int overlap = math.max(0, math.min(firstEnd, secondEnd) - math.max(firstStart, secondStart))
    int shortest = math.max(1, math.min(firstEnd - firstStart, secondEnd - secondStart))
    overlap * 1.0 / shortest

f_windowRange(int startBar, int endBar) =>
    float windowHigh = na
    float windowLow = na
    bool valid = startBar >= 0 and endBar >= startBar and endBar - startBar + 1 <= 200 and bar_index - startBar <= 999 and bar_index - endBar >= 0
    if valid
        int sampleCount = endBar - startBar + 1
        int endOffset = bar_index - endBar
        for sample = 0 to sampleCount - 1
            float valueHigh = high[endOffset + sample]
            float valueLow = low[endOffset + sample]
            windowHigh := na(windowHigh) ? valueHigh : math.max(windowHigh, valueHigh)
            windowLow := na(windowLow) ? valueLow : math.min(windowLow, valueLow)
    [windowHigh, windowLow, valid]

f_closeAt(int sourceBar) =>
    float result = na
    int offset = bar_index - sourceBar
    if offset >= 0 and offset <= 999
        result := close[offset]
    result

// Chronological least-squares slope for bounded bump-and-run segments.
f_segmentSlope(int startBar, int endBar, float atrValue) =>
    float result = na
    bool valid = startBar >= 0 and endBar > startBar and bar_index - startBar <= 999 and endBar - startBar + 1 <= 200
    if valid
        int count = endBar - startBar + 1
        float sumX = 0.0
        float sumY = 0.0
        float sumXX = 0.0
        float sumXY = 0.0
        int endOffset = bar_index - endBar
        for sample = 0 to count - 1
            float x = sample
            float y = close[endOffset + count - 1 - sample]
            sumX += x
            sumY += y
            sumXX += x * x
            sumXY += x * y
        float denominator = count * sumXX - sumX * sumX
        if denominator != 0.0 and not na(atrValue)
            result := ((count * sumXY - sumX * sumY) / denominator) / math.max(atrValue, syminfo.mintick)
    result

// Chronological quadratic fit. A positive coefficient is a rounded bottom and
// a negative coefficient is a rounded top. Invalid windows return explicit na.
f_curve(int startBar, int endBar) =>
    float curve = na
    float linearCoefficient = na
    float constantCoefficient = na
    float fitR2 = na
    int count = endBar - startBar + 1
    int endOffset = bar_index - endBar
    bool valid = count >= 9 and count <= 80 and startBar >= 0 and endOffset >= 0 and bar_index - startBar <= 999
    if valid
        float sx = 0.0
        float sx2 = 0.0
        float sx3 = 0.0
        float sx4 = 0.0
        float sy = 0.0
        float sxy = 0.0
        float sx2y = 0.0
        for sample = 0 to count - 1
            float x = sample
            float y = close[endOffset + count - 1 - sample]
            sx += x
            sx2 += x * x
            sx3 += x * x * x
            sx4 += x * x * x * x
            sy += y
            sxy += x * y
            sx2y += x * x * y
        float determinant = count * (sx2 * sx4 - sx3 * sx3) - sx * (sx * sx4 - sx2 * sx3) + sx2 * (sx * sx3 - sx2 * sx2)
        if math.abs(determinant) > 0.0000000001
            float coefficientA = (count * (sx2 * sx2y - sx3 * sxy) - sx * (sx * sx2y - sx2 * sxy) + sy * (sx * sx3 - sx2 * sx2)) / determinant
            float coefficientB = (count * (sxy * sx4 - sx2y * sx3) - sy * (sx * sx4 - sx2 * sx3) + sx2 * (sx * sx2y - sxy * sx2)) / determinant
            float coefficientC = (sy * (sx2 * sx4 - sx3 * sx3) - sx * (sxy * sx4 - sx2y * sx3) + sx2 * (sxy * sx3 - sx2y * sx2)) / determinant
            float mean = sy / count
            float total = 0.0
            float error = 0.0
            for sample = 0 to count - 1
                float y = close[endOffset + count - 1 - sample]
                float fitted = coefficientA * sample * sample + coefficientB * sample + coefficientC
                total += math.pow(y - mean, 2)
                error += math.pow(y - fitted, 2)
            curve := coefficientA
            linearCoefficient := coefficientB
            constantCoefficient := coefficientC
            fitR2 := total > 0.0 ? 1.0 - error / total : na
    [curve, linearCoefficient, constantCoefficient, fitR2, count]

// Confirmed alternating swing engine ------------------------------------------
var array<int> pivotTypes = array.new_int()
var array<float> pivotPrices = array.new_float()
var array<int> pivotBars = array.new_int()
var array<float> pivotATRs = array.new_float()

f_pivotType(int back) =>
    array.get(pivotTypes, array.size(pivotTypes) - 1 - back)

f_pivotPrice(int back) =>
    array.get(pivotPrices, array.size(pivotPrices) - 1 - back)

f_pivotBar(int back) =>
    array.get(pivotBars, array.size(pivotBars) - 1 - back)

f_pivotATR(int back) =>
    array.get(pivotATRs, array.size(pivotATRs) - 1 - back)

f_shiftPivot() =>
    array.shift(pivotTypes)
    array.shift(pivotPrices)
    array.shift(pivotBars)
    array.shift(pivotATRs)

f_acceptPivot(int pivotType, float pivotPrice, int pivotBar, float pivotATR) =>
    bool changed = false
    int size = array.size(pivotTypes)
    if size == 0
        array.push(pivotTypes, pivotType)
        array.push(pivotPrices, pivotPrice)
        array.push(pivotBars, pivotBar)
        array.push(pivotATRs, pivotATR)
        changed := true
    else
        int lastIndex = size - 1
        int lastType = array.get(pivotTypes, lastIndex)
        if lastType != pivotType
            array.push(pivotTypes, pivotType)
            array.push(pivotPrices, pivotPrice)
            array.push(pivotBars, pivotBar)
            array.push(pivotATRs, pivotATR)
            changed := true
        else
            float oldPrice = array.get(pivotPrices, lastIndex)
            bool moreExtreme = pivotType == PIVOT_HIGH ? pivotPrice > oldPrice : pivotPrice < oldPrice
            if moreExtreme
                array.set(pivotPrices, lastIndex, pivotPrice)
                array.set(pivotBars, lastIndex, pivotBar)
                array.set(pivotATRs, lastIndex, pivotATR)
                changed := true
    while array.size(pivotTypes) > maxP
        f_shiftPivot()
    changed

float confirmedHigh = ta.pivothigh(high, left, right)
float confirmedLow = ta.pivotlow(low, left, right)
bool hasHigh = not na(confirmedHigh)
bool hasLow = not na(confirmedLow)
int confirmedBar = bar_index - right
float confirmedATR = atr[right]
bool structuralPivotChanged = false

if hasHigh and hasLow
    // Simultaneous PH/PL rule: retain the candidate with the larger ATR-normalized
    // excursion from the last structural pivot. Exact ties prefer the type that
    // alternates from the last pivot; a final tie deterministically prefers HIGH.
    float previousPrice = array.size(pivotPrices) > 0 ? array.get(pivotPrices, array.size(pivotPrices) - 1) : close[right]
    int previousType = array.size(pivotTypes) > 0 ? array.get(pivotTypes, array.size(pivotTypes) - 1) : 0
    float highExcursion = math.abs(confirmedHigh - previousPrice) / math.max(confirmedATR, syminfo.mintick)
    float lowExcursion = math.abs(confirmedLow - previousPrice) / math.max(confirmedATR, syminfo.mintick)
    bool chooseHigh = highExcursion > lowExcursion or (highExcursion == lowExcursion and previousType != PIVOT_HIGH)
    structuralPivotChanged := chooseHigh ? f_acceptPivot(PIVOT_HIGH, confirmedHigh, confirmedBar, confirmedATR) : f_acceptPivot(PIVOT_LOW, confirmedLow, confirmedBar, confirmedATR)
else if hasHigh
    structuralPivotChanged := f_acceptPivot(PIVOT_HIGH, confirmedHigh, confirmedBar, confirmedATR)
else if hasLow
    structuralPivotChanged := f_acceptPivot(PIVOT_LOW, confirmedLow, confirmedBar, confirmedATR)

// Frozen prior-trend series ----------------------------------------------------
float recentHigh = na
float previousHigh = na
float recentLow = na
float previousLow = na
int highCount = 0
int lowCount = 0
if array.size(pivotTypes) > 0
    for scan = 0 to math.min(array.size(pivotTypes) - 1, 11)
        if f_pivotType(scan) == PIVOT_HIGH and highCount < 2
            if highCount == 0
                recentHigh := f_pivotPrice(scan)
            else
                previousHigh := f_pivotPrice(scan)
            highCount += 1
        if f_pivotType(scan) == PIVOT_LOW and lowCount < 2
            if lowCount == 0
                recentLow := f_pivotPrice(scan)
            else
                previousLow := f_pivotPrice(scan)
            lowCount += 1
int structureScore = 0
if not na(previousHigh) and not na(previousLow)
    structureScore := recentHigh > previousHigh and recentLow > previousLow ? 2 : recentHigh < previousHigh and recentLow < previousLow ? -2 : 0
int slopeScore = normalizedTrendSlope > slopeThr ? 1 : normalizedTrendSlope < -slopeThr ? -1 : 0
float emaNormalizedSlope = (fast - fast[3]) / math.max(atr, syminfo.mintick) / 3.0
int emaScore = fast > slow and emaNormalizedSlope > slopeThr * 0.25 ? 1 : fast < slow and emaNormalizedSlope < -slopeThr * 0.25 ? -1 : 0
int trendScore = structureScore + slopeScore + emaScore
int trendState = trendScore >= upScore ? TREND_UP : trendScore <= downScore ? TREND_DOWN : TREND_ANY
var int trendPersistence = 0
trendPersistence := trendState != TREND_ANY ? (trendState == trendState[1] ? nz(trendPersistence[1]) + 1 : 1) : 0
float structureComponent = math.abs(structureScore) == 2 ? 35.0 : 0.0
float slopeComponent = math.min(math.abs(normalizedTrendSlope) / math.max(slopeThr * 4.0, 0.0001), 1.0) * 25.0
float emaComponent = emaScore != 0 and math.sign(emaScore) == math.sign(trendState) ? 15.0 : 0.0
float persistenceComponent = math.min(trendPersistence * 1.0 / minPriorTrendBars, 1.0) * 25.0
float trendStrength = f_clamp(structureComponent + slopeComponent + emaComponent + persistenceComponent)

f_prior(int patternStart) =>
    int offset = bar_index - patternStart + 1
    int priorState = TREND_ANY
    float priorStrength = 0.0
    int priorPersistence = 0
    float priorStructureComponent = 0.0
    float priorSlopeComponent = 0.0
    float priorEMAComponent = 0.0
    float priorPersistenceComponent = 0.0
    bool available = offset >= 0 and offset <= 999
    if available
        priorState := trendState[offset]
        priorStrength := trendStrength[offset]
        priorPersistence := trendPersistence[offset]
        priorStructureComponent := structureComponent[offset]
        priorSlopeComponent := slopeComponent[offset]
        priorEMAComponent := emaComponent[offset]
        priorPersistenceComponent := persistenceComponent[offset]
    [priorState, priorStrength, priorPersistence, priorStructureComponent, priorSlopeComponent, priorEMAComponent, priorPersistenceComponent, available]

f_trendName(int value) =>
    value == TREND_UP ? "UP" : value == TREND_DOWN ? "DOWN" : "SIDEWAYS"

// Candidate model -------------------------------------------------------------
type PatternCandidate
    string name
    string code
    int startBar
    int endBar
    int knowledgeBar
    int status
    int requiredTrend
    int expectedBreakout
    int contextMode
    int priorTrend
    float priorStrength
    int priorPersistence
    float contextScore
    float priorStructureComponent
    float priorSlopeComponent
    float priorEMAComponent
    float priorPersistenceComponent
    int upperBar1
    float upperPrice1
    int upperBar2
    float upperPrice2
    int lowerBar1
    float lowerPrice1
    int lowerBar2
    float lowerPrice2
    int invalidMode
    float invalidLevel
    float geometryScore
    float toleranceAtCreation
    bool expiresAtBoundaryCross
    string pivotSignature
    label formingLabel

type DisplayedPattern
    string code
    int direction
    int priorTrend
    int startBar
    int endBar
    int breakoutBar
    float finalQuality
    float upperAtBreakout
    float lowerAtBreakout
    float atrAtBreakout
    float toleranceAtBreakout
    label signalLabel
    line upperLine
    line lowerLine
    line necklineLine
    line breakoutMarker

var array<PatternCandidate> candidates = array.new<PatternCandidate>()
var array<DisplayedPattern> displayedPatterns = array.new<DisplayedPattern>()
var array<string> emittedIDs = array.new_string()
var array<label> managedLabels = array.new_label()
var int serial = 0
var int activeCount = 0
var string latestName = "—"
var string latestClass = "—"
var string latestStatus = "—"
var string latestTrend = "—"
var string latestID = "—"
var float latestQuality = na
var float latestLevel = na
var float latestATR = na
var float latestStrength = na
var float latestGeometryScore = na
var float latestContextScore = na
var float latestBreakoutScore = na
var int latestPatternBars = na
var float latestPriorStructureComponent = na
var float latestPriorSlopeComponent = na
var float latestPriorEMAComponent = na
var float latestPriorPersistenceComponent = na
var int confirmedEventCounter = 0

f_codeOrder(string code) =>
    int order = 999
    order := code == "DT" ? 1 : code == "DB" ? 2 : code == "TT" ? 3 : code == "TB" ? 4 : code == "HNS" ? 5 : code == "IHNS" ? 6 : code == "RT" ? 7 : code == "RB" ? 8 : code == "DIA-T" ? 9 : code == "DIA-B" ? 10 : code == "VT" ? 11 : code == "VB" ? 12 : code == "MEGA" ? 13 : code == "BRT" ? 14 : code == "BRB" ? 15 : code == "RW" ? 16 : code == "FW" ? 17 : code == "AT" ? 18 : code == "DTR" ? 19 : code == "ST" ? 20 : code == "BFLAG" ? 21 : code == "SFLAG" ? 22 : code == "BPEN" ? 23 : code == "SPEN" ? 24 : code == "RECT" ? 25 : code == "CUP" ? 26 : code == "ICUP" ? 27 : code == "DIA-CU" ? 28 : code == "DIA-CD" ? 29 : 999
    order

f_manageLabel(label handle) =>
    if not na(handle)
        array.push(managedLabels, handle)
        while array.size(managedLabels) > 120
            label.delete(array.shift(managedLabels))

f_deletePatternDrawings(DisplayedPattern displayed) =>
    if not na(displayed.upperLine)
        line.delete(displayed.upperLine)
        displayed.upperLine := na
    if not na(displayed.lowerLine)
        line.delete(displayed.lowerLine)
        displayed.lowerLine := na
    if not na(displayed.necklineLine)
        line.delete(displayed.necklineLine)
        displayed.necklineLine := na
    if not na(displayed.breakoutMarker)
        line.delete(displayed.breakoutMarker)
        displayed.breakoutMarker := na

f_clusterMatch(DisplayedPattern displayed, PatternCandidate candidate, int direction, int breakoutBar, float upperBoundary, float lowerBoundary) =>
    float overlap = f_overlapRatio(displayed.startBar, displayed.endBar, candidate.startBar, candidate.endBar)
    bool closeBreakout = math.abs(displayed.breakoutBar - breakoutBar) <= displayClusterBreakoutBars
    float clusterTolerance = math.max(displayed.toleranceAtBreakout, candidate.toleranceAtCreation)
    bool upperSimilar = na(displayed.upperAtBreakout) and na(upperBoundary) or not na(displayed.upperAtBreakout) and not na(upperBoundary) and math.abs(displayed.upperAtBreakout - upperBoundary) <= clusterTolerance * 2.0
    bool lowerSimilar = na(displayed.lowerAtBreakout) and na(lowerBoundary) or not na(displayed.lowerAtBreakout) and not na(lowerBoundary) and math.abs(displayed.lowerAtBreakout - lowerBoundary) <= clusterTolerance * 2.0
    displayed.code == candidate.code and displayed.direction == direction and displayed.priorTrend == candidate.priorTrend and overlap >= displayClusterOverlap and closeBreakout and upperSimilar and lowerSimilar

f_applyDrawingRetention() =>
    int count = array.size(displayedPatterns)
    if count > 0
        int keepCount = drawingMode == "Latest Only" ? 1 : drawingMode == "Last N" ? lastNPatterns : 50
        int firstKept = math.max(0, count - keepCount)
        for drawingIndex = 0 to count - 1
            if drawingIndex < firstKept
                DisplayedPattern oldDisplay = array.get(displayedPatterns, drawingIndex)
                f_deletePatternDrawings(oldDisplay)
        while array.size(displayedPatterns) > 100
            DisplayedPattern removedDisplay = array.shift(displayedPatterns)
            f_deletePatternDrawings(removedDisplay)

f_deleteForming(PatternCandidate candidate) =>
    if not na(candidate.formingLabel)
        label.delete(candidate.formingLabel)
        candidate.formingLabel := na

f_candidateShift() =>
    if array.size(candidates) > 0
        PatternCandidate removed = array.shift(candidates)
        f_deleteForming(removed)

f_candidateMakeRoom() =>
    while array.size(candidates) >= maxActive
        int resolvedIndex = -1
        if array.size(candidates) > 0
            for cleanupIndex = 0 to array.size(candidates) - 1
                PatternCandidate cleanupCandidate = array.get(candidates, cleanupIndex)
                if resolvedIndex < 0 and cleanupCandidate.status != STATUS_FORMING
                    resolvedIndex := cleanupIndex
        if resolvedIndex >= 0
            PatternCandidate removedResolved = array.remove(candidates, resolvedIndex)
            f_deleteForming(removedResolved)
        else
            f_candidateShift()

f_boundaryUpper(PatternCandidate candidate, int targetBar) =>
    f_lineValueAt(candidate.upperBar1, candidate.upperPrice1, candidate.upperBar2, candidate.upperPrice2, targetBar)

f_boundaryLower(PatternCandidate candidate, int targetBar) =>
    f_lineValueAt(candidate.lowerBar1, candidate.lowerPrice1, candidate.lowerBar2, candidate.lowerPrice2, targetBar)

f_requiresMeaningfulTrend(string code) =>
    code == "RW" or code == "FW"

f_contextValid(string code, int requiredTrend, float priorStrength, int priorPersistence, int contextMode, int priorTrend) =>
    bool trendMatches = requiredTrend == TREND_ANY or priorTrend == requiredTrend
    bool strengthRequired = requiredTrend != TREND_ANY or contextMode == MODE_REVERSAL or contextMode == MODE_CONTINUATION or f_requiresMeaningfulTrend(code)
    bool persistenceRequired = requiredTrend != TREND_ANY or f_requiresMeaningfulTrend(code)
    bool nonSidewaysRequired = f_requiresMeaningfulTrend(code)
    trendMatches and (not strengthRequired or priorStrength >= minTrend) and (not persistenceRequired or priorPersistence >= minPriorTrendBars) and (not nonSidewaysRequired or priorTrend != TREND_ANY)

f_classification(PatternCandidate candidate, int direction) =>
    string result = direction == BREAK_UP ? "BULLISH_BREAKOUT" : "BEARISH_BREAKOUT"
    bool meaningfulContext = candidate.priorTrend != TREND_ANY and candidate.priorStrength >= minTrend and candidate.priorPersistence >= minPriorTrendBars
    if candidate.contextMode == MODE_CONTINUATION
        result := direction == BREAK_UP ? "BULLISH_CONTINUATION" : "BEARISH_CONTINUATION"
    else if candidate.contextMode == MODE_REVERSAL
        result := direction == BREAK_UP ? "BULLISH_REVERSAL" : "BEARISH_REVERSAL"
    else if candidate.contextMode == MODE_CONTEXTUAL
        result := not meaningfulContext ? (direction == BREAK_UP ? "BULLISH_BREAKOUT" : "BEARISH_BREAKOUT") : direction == BREAK_UP ? (candidate.priorTrend == TREND_DOWN ? "BULLISH_REVERSAL" : "BULLISH_CONTINUATION") : (candidate.priorTrend == TREND_UP ? "BEARISH_REVERSAL" : "BEARISH_CONTINUATION")
    result

f_candidateSimilar(PatternCandidate oldCandidate, PatternCandidate newCandidate) =>
    bool exactSignature = oldCandidate.pivotSignature == newCandidate.pivotSignature
    float overlap = f_overlapRatio(oldCandidate.startBar, oldCandidate.endBar, newCandidate.startBar, newCandidate.endBar)
    float oldUpper = f_boundaryUpper(oldCandidate, newCandidate.endBar)
    float newUpper = f_boundaryUpper(newCandidate, newCandidate.endBar)
    float oldLower = f_boundaryLower(oldCandidate, newCandidate.endBar)
    float newLower = f_boundaryLower(newCandidate, newCandidate.endBar)
    float duplicateTolerance = math.max(oldCandidate.toleranceAtCreation, newCandidate.toleranceAtCreation)
    bool upperSimilar = na(oldUpper) and na(newUpper) or not na(oldUpper) and not na(newUpper) and math.abs(oldUpper - newUpper) <= duplicateTolerance
    bool lowerSimilar = na(oldLower) and na(newLower) or not na(oldLower) and not na(newLower) and math.abs(oldLower - newLower) <= duplicateTolerance
    bool closeStart = math.abs(oldCandidate.startBar - newCandidate.startBar) <= right * 2
    oldCandidate.code == newCandidate.code and (exactSignature or (overlap >= 0.70 and closeStart and upperSimilar and lowerSimilar))

f_offer(string name, string code, int startBar, int endBar, int requiredTrend, int expectedBreakout, int contextMode, int upperBar1, float upperPrice1, int upperBar2, float upperPrice2, int lowerBar1, float lowerPrice1, int lowerBar2, float lowerPrice2, int invalidMode, float invalidLevel, float geometryScore, string pivotSignature) =>
    [priorTrend, priorStrength, priorPersistence, priorStructure, priorSlope, priorEMA, priorPersistenceScore, historyAvailable] = f_prior(startBar)
    bool structurallyComplete = historyAvailable and endBar >= startBar and not na(geometryScore)
    bool contextAccepted = structurallyComplete and f_contextValid(code, requiredTrend, priorStrength, priorPersistence, contextMode, priorTrend)
    bool qualityAccepted = geometryScore >= minGeometryScore or showLow
    bool auditGap = structurallyComplete and contextAccepted and qualityAccepted
    [gapInvalidated, gapHistoryAvailable, gapReason] = f_confirmationGapInvalidated(auditGap, endBar, expectedBreakout, invalidMode, invalidLevel, upperBar1, upperPrice1, upperBar2, upperPrice2, lowerBar1, lowerPrice1, lowerBar2, lowerPrice2)
    float contextScore = priorTrend == TREND_ANY ? 35.0 : priorStrength
    float creationTolerance = f_tolerance(atr)
    bool expiresAtCross = f_expiresAtBoundaryCross(code)
    PatternCandidate proposed = PatternCandidate.new(name, code, startBar, endBar, bar_index, STATUS_FORMING, requiredTrend, expectedBreakout, contextMode, priorTrend, priorStrength, priorPersistence, contextScore, priorStructure, priorSlope, priorEMA, priorPersistenceScore, upperBar1, upperPrice1, upperBar2, upperPrice2, lowerBar1, lowerPrice1, lowerBar2, lowerPrice2, invalidMode, invalidLevel, geometryScore, creationTolerance, expiresAtCross, pivotSignature, na)
    int duplicateIndex = -1
    bool resolvedSimilarIgnored = false
    if array.size(candidates) > 0
        for index = 0 to array.size(candidates) - 1
            PatternCandidate oldCandidate = array.get(candidates, index)
            bool similar = f_candidateSimilar(oldCandidate, proposed)
            if oldCandidate.status == STATUS_FORMING and similar
                duplicateIndex := index
            else if oldCandidate.status != STATUS_FORMING and similar
                resolvedSimilarIgnored := true
    bool accepted = contextAccepted and qualityAccepted and gapHistoryAvailable and not gapInvalidated
    if accepted and duplicateIndex >= 0
        PatternCandidate oldCandidate = array.get(candidates, duplicateIndex)
        if proposed.geometryScore > oldCandidate.geometryScore and oldCandidate.status == STATUS_FORMING
            f_deleteForming(oldCandidate)
            if showForming and showLabels
                proposed.formingLabel := label.new(bar_index, close, code + " FORMING\nQ:" + str.tostring(math.round(geometryScore)), style = label.style_label_left, color = color.new(color.orange, 25), textcolor = color.white, size = size.tiny)
                f_manageLabel(proposed.formingLabel)
            // Full-object replacement prevents mixed start/trend/boundary metadata.
            array.set(candidates, duplicateIndex, proposed)
        if debugMode
            label duplicateDebug = label.new(bar_index, high, "SUPPRESS " + code + "\ncandidate duplicate", style = label.style_label_down, color = color.new(color.purple, 55), textcolor = color.white, size = size.tiny)
            f_manageLabel(duplicateDebug)
    else if accepted
        f_candidateMakeRoom()
        if showForming and showLabels
            proposed.formingLabel := label.new(bar_index, close, code + " FORMING\nQ:" + str.tostring(math.round(geometryScore)), style = label.style_label_left, color = color.new(color.orange, 25), textcolor = color.white, size = size.tiny)
            f_manageLabel(proposed.formingLabel)
        array.push(candidates, proposed)
        if debugMode
            label acceptedDebugLabel = label.new(bar_index, low, code + " candidate\nBars: " + str.tostring(endBar - startBar) + "\nPrior: " + f_trendName(priorTrend) + " " + str.tostring(math.round(priorStrength)) + " (" + str.tostring(priorPersistence) + " bars)\nGeometry: " + str.tostring(math.round(geometryScore)) + "\nContext: " + str.tostring(math.round(contextScore)), style = label.style_label_up, color = color.new(color.blue, 55), textcolor = color.white, size = size.tiny)
            f_manageLabel(acceptedDebugLabel)
            if resolvedSimilarIgnored
                label resolvedDebugLabel = label.new(bar_index, low, "ALLOW " + code + "\nresolved candidate ignored by forming dedupe", style = label.style_label_up, color = color.new(color.teal, 55), textcolor = color.white, size = size.tiny)
                f_manageLabel(resolvedDebugLabel)
    else if debugMode and duplicateIndex < 0
        string reason = not structurallyComplete or not gapHistoryAvailable ? "history unavailable" : gapInvalidated ? gapReason : not contextAccepted ? "context" : "geometry " + str.tostring(math.round(geometryScore)) + " < " + str.tostring(minGeometryScore)
        label debugLabel = label.new(bar_index, high, "REJECT " + code + "\nTrend " + f_trendName(priorTrend) + " " + str.tostring(math.round(priorStrength)) + "\nTol " + str.tostring(levelTolerance, format.mintick) + " G " + str.tostring(math.round(geometryScore)) + "\n" + reason, style = label.style_label_down, color = color.new(color.gray, 60), textcolor = color.white, size = size.tiny)
        f_manageLabel(debugLabel)

// Geometry detection is event-driven by a confirmed append or extreme replacement.
if structuralPivotChanged and array.size(pivotTypes) >= 5
    int patternStart = f_pivotBar(4)
    int patternEnd = f_pivotBar(0)
    float a = f_pivotPrice(4)
    float b = f_pivotPrice(3)
    float c = f_pivotPrice(2)
    float d = f_pivotPrice(1)
    float e = f_pivotPrice(0)
    int barA = f_pivotBar(4)
    int barB = f_pivotBar(3)
    int barC = f_pivotBar(2)
    int barD = f_pivotBar(1)
    int barE = f_pivotBar(0)
    float patternATR = f_pivotATR(0)
    string signature = str.tostring(barA) + "," + str.tostring(barB) + "," + str.tostring(barC) + "," + str.tostring(barD) + "," + str.tostring(barE)
    float temporalSymmetry = 100.0 - math.abs((barC - barA) - (barE - barC)) / math.max(patternEnd - patternStart, 1) * 100.0
    bool highSequence = f_pivotType(4) == PIVOT_HIGH
    float upper1 = highSequence ? a : b
    float upper2 = highSequence ? e : d
    float lower1 = highSequence ? b : a
    float lower2 = highSequence ? d : e
    int upperBar1 = highSequence ? barA : barB
    int upperBar2 = highSequence ? barE : barD
    int lowerBar1 = highSequence ? barB : barA
    int lowerBar2 = highSequence ? barD : barE
    float upperSlope = f_normalizedSlope(upper1, upper2, upperBar1, upperBar2, patternATR)
    float lowerSlope = f_normalizedSlope(lower1, lower2, lowerBar1, lowerBar2, patternATR)
    int commonStart = math.max(upperBar1, lowerBar1)
    int commonEnd = math.min(upperBar2, lowerBar2)
    float startWidth = f_lineValueAt(upperBar1, upper1, upperBar2, upper2, commonStart) - f_lineValueAt(lowerBar1, lower1, lowerBar2, lower2, commonStart)
    float endWidth = f_lineValueAt(upperBar1, upper1, upperBar2, upper2, commonEnd) - f_lineValueAt(lowerBar1, lower1, lowerBar2, lower2, commonEnd)
    bool contracting = endWidth > 0.0 and endWidth < startWidth
    bool expanding = startWidth > 0.0 and endWidth > startWidth
    float flatThreshold = 0.025
    float boundaryQuality = f_clamp(100.0 - (math.abs(upperSlope) + math.abs(lowerSlope)) * 120.0)
    int patternBars = patternEnd - patternStart
    float startWidthATR = startWidth / math.max(patternATR, syminfo.mintick)
    float contractionRatio = startWidth > 0.0 ? (startWidth - endWidth) / startWidth : 0.0

    // Equal-level reversal structures use explicit static neckline boundaries.
    if fDouble and f_pivotType(2) == f_pivotType(0) and f_equalLevel(c, e, patternATR)
        bool isTop = f_pivotType(0) == PIVOT_HIGH
        int doubleSeparation = barE - barC
        bool doubleSeparationValid = doubleSeparation >= minDoubleSeparationBars and doubleSeparation <= maxDoubleSeparationBars
        float neckline = d
        float doubleDepthATR = math.abs((c + e) / 2.0 - neckline) / math.max(patternATR, syminfo.mintick)
        float levelAccuracy = f_clamp(1.0 - math.abs(c - e) / math.max(f_tolerance(patternATR), syminfo.mintick))
        float geometry = f_clamp(levelAccuracy * 40.0 + math.min(doubleDepthATR / 2.0, 1.0) * 35.0 + temporalSymmetry / 100.0 * 25.0)
        if isTop and doubleDepthATR >= minDoubleDepthATR and doubleSeparationValid
            f_offer("Double Top", "DT", barC, barE, TREND_UP, BREAK_DOWN, MODE_REVERSAL, barD, c + f_tolerance(patternATR), barD, c + f_tolerance(patternATR), barD, d, barD, d, INVALID_STATIC, math.max(c, e) + f_tolerance(patternATR), geometry, signature)
        if not isTop and doubleDepthATR >= minDoubleDepthATR and doubleSeparationValid
            f_offer("Double Bottom", "DB", barC, barE, TREND_DOWN, BREAK_UP, MODE_REVERSAL, barD, d, barD, d, barD, c - f_tolerance(patternATR), barD, c - f_tolerance(patternATR), INVALID_STATIC, math.min(c, e) - f_tolerance(patternATR), geometry, signature)
        if debugMode and doubleDepthATR >= minDoubleDepthATR and not doubleSeparationValid
            string doubleCode = isTop ? "DT" : "DB"
            string separationReason = doubleSeparation < minDoubleSeparationBars ? "separation " + str.tostring(doubleSeparation) + " < " + str.tostring(minDoubleSeparationBars) : "separation " + str.tostring(doubleSeparation) + " > " + str.tostring(maxDoubleSeparationBars)
            label doubleReject = label.new(bar_index, high, "REJECT " + doubleCode + "\n" + separationReason, style = label.style_label_down, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny)
            f_manageLabel(doubleReject)
    if fTriple and f_pivotType(4) == f_pivotType(2) and f_pivotType(2) == f_pivotType(0) and f_equalLevel(a, c, patternATR) and f_equalLevel(c, e, patternATR)
        bool isTop = f_pivotType(0) == PIVOT_HIGH
        bool tripleSpacingValid = barC - barA >= minTripleLegBars and barE - barC >= minTripleLegBars and barE - barA <= maxTripleSpanBars
        if isTop
            float support = math.min(b, d)
            float depthATR = ((a + c + e) / 3.0 - support) / math.max(patternATR, syminfo.mintick)
            float geometry = f_clamp(math.min(depthATR / 2.0, 1.0) * 45.0 + temporalSymmetry / 100.0 * 25.0 + 30.0 * (1.0 - math.max(math.abs(a - c), math.abs(c - e)) / math.max(f_tolerance(patternATR), syminfo.mintick)))
            if depthATR >= minDoubleDepthATR and tripleSpacingValid
                f_offer("Triple Top", "TT", barA, barE, TREND_UP, BREAK_DOWN, MODE_REVERSAL, barA, math.max(a, math.max(c, e)), barE, math.max(a, math.max(c, e)), barB, support, barD, support, INVALID_STATIC, math.max(a, math.max(c, e)) + f_tolerance(patternATR), geometry, signature)
        else
            float resistance = math.max(b, d)
            float depthATR = (resistance - (a + c + e) / 3.0) / math.max(patternATR, syminfo.mintick)
            float geometry = f_clamp(math.min(depthATR / 2.0, 1.0) * 45.0 + temporalSymmetry / 100.0 * 25.0 + 30.0 * (1.0 - math.max(math.abs(a - c), math.abs(c - e)) / math.max(f_tolerance(patternATR), syminfo.mintick)))
            if depthATR >= minDoubleDepthATR and tripleSpacingValid
                f_offer("Triple Bottom", "TB", barA, barE, TREND_DOWN, BREAK_UP, MODE_REVERSAL, barB, resistance, barD, resistance, barA, math.min(a, math.min(c, e)), barE, math.min(a, math.min(c, e)), INVALID_STATIC, math.min(a, math.min(c, e)) - f_tolerance(patternATR), geometry, signature)
        if debugMode and not tripleSpacingValid
            label tripleReject = label.new(bar_index, high, "REJECT " + (isTop ? "TT" : "TB") + "\npivot spacing invalid", style = label.style_label_down, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny)
            f_manageLabel(tripleReject)

    // H&S uses the actual two neckline pivots and projects their line.
    if fHns and f_pivotType(4) == f_pivotType(2) and f_pivotType(2) == f_pivotType(0) and f_equalLevel(a, e, patternATR)
        bool headAndShoulders = f_pivotType(0) == PIVOT_HIGH and c > a + f_tolerance(patternATR)
        bool inverseHeadAndShoulders = f_pivotType(0) == PIVOT_LOW and c < a - f_tolerance(patternATR)
        float prominence = math.abs(c - (a + e) / 2.0) / math.max(patternATR, syminfo.mintick)
        float shoulderAccuracy = f_clamp(1.0 - math.abs(a - e) / math.max(f_tolerance(patternATR), syminfo.mintick))
        float hnsGeometry = f_clamp(math.min(prominence / 1.5, 1.0) * 45.0 + shoulderAccuracy * 30.0 + temporalSymmetry / 100.0 * 25.0)
        if headAndShoulders and prominence >= headProminenceATR
            f_offer("Head and Shoulders", "HNS", barA, barE, TREND_UP, BREAK_DOWN, MODE_REVERSAL, barC, c, barC, c, barB, b, barD, d, INVALID_STATIC, c + f_tolerance(patternATR), hnsGeometry, signature)
        if inverseHeadAndShoulders and prominence >= headProminenceATR
            f_offer("Inverse Head and Shoulders", "IHNS", barA, barE, TREND_DOWN, BREAK_UP, MODE_REVERSAL, barB, b, barD, d, barC, c, barC, c, INVALID_STATIC, c - f_tolerance(patternATR), hnsGeometry, signature)

    // True mirrored contracting wedge inequalities.
    if fWedge and contracting and not na(upperSlope) and not na(lowerSlope)
        float upperRawSlope = (upper2 - upper1) / math.max(upperBar2 - upperBar1, 1)
        float lowerRawSlope = (lower2 - lower1) / math.max(lowerBar2 - lowerBar1, 1)
        float slopeDifference = upperRawSlope - lowerRawSlope
        float apexBar = math.abs(slopeDifference) > syminfo.mintick * 0.0001 ? (lower1 - upper1 + upperRawSlope * upperBar1 - lowerRawSlope * lowerBar1) / slopeDifference : na
        float apexDistance = not na(apexBar) ? apexBar - patternEnd : na
        bool apexValid = not na(apexDistance) and apexDistance > 0.0 and apexDistance <= patternBars * maxApexDistanceMultiple
        bool wedgeThresholds = patternBars >= minWedgeBars and startWidthATR >= minWedgeStartWidthATR and contractionRatio >= minWedgeContractionRatio and apexValid
        float durationPoints = math.min(patternBars * 1.0 / (minWedgeBars * 2.0), 1.0) * 15.0
        float widthPoints = math.min(startWidthATR / (minWedgeStartWidthATR * 2.0), 1.0) * 15.0
        float contractionPoints = math.min(contractionRatio / 0.60, 1.0) * 35.0
        float apexPoints = apexValid ? math.max(0.0, 1.0 - apexDistance / (patternBars * maxApexDistanceMultiple)) * 20.0 : 0.0
        float slopePoints = math.min(math.abs(lowerSlope - upperSlope) / 0.15, 1.0) * 15.0
        float wedgeGeometry = f_clamp(durationPoints + widthPoints + contractionPoints + apexPoints + slopePoints)
        if wedgeThresholds and lowerSlope > upperSlope and upperSlope > 0.0
            f_offer("Rising Wedge", "RW", patternStart, patternEnd, TREND_ANY, BREAK_DOWN, MODE_CONTEXTUAL, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_OPPOSITE_BOUNDARY, na, wedgeGeometry, signature)
            if debugMode
                [wedgeTrend, wedgeStrength, wedgePersistence, wedgeStructure, wedgeSlope, wedgeEMA, wedgePersistenceScore, wedgeHistory] = f_prior(patternStart)
                label wedgePass = label.new(bar_index, low, "RW geometry pass\nBars: " + str.tostring(patternBars) + "\nWidth: " + str.tostring(startWidthATR, "#.##") + "→" + str.tostring(endWidth / math.max(patternATR, syminfo.mintick), "#.##") + " ATR\nContraction: " + str.tostring(contractionRatio * 100.0, "#.0") + "%\nSlopes: " + str.tostring(upperSlope, "#.###") + " / " + str.tostring(lowerSlope, "#.###") + "\nApex: " + str.tostring(math.round(apexDistance)) + " bars\nPrior: " + f_trendName(wedgeTrend) + " " + str.tostring(math.round(wedgeStrength)) + "\nGeometry: " + str.tostring(math.round(wedgeGeometry)), style = label.style_label_up, color = color.new(color.blue, 55), textcolor = color.white, size = size.tiny)
                f_manageLabel(wedgePass)
        if wedgeThresholds and upperSlope < lowerSlope and lowerSlope < 0.0
            f_offer("Falling Wedge", "FW", patternStart, patternEnd, TREND_ANY, BREAK_UP, MODE_CONTEXTUAL, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_OPPOSITE_BOUNDARY, na, wedgeGeometry, signature)
            if debugMode
                [wedgeTrend, wedgeStrength, wedgePersistence, wedgeStructure, wedgeSlope, wedgeEMA, wedgePersistenceScore, wedgeHistory] = f_prior(patternStart)
                label wedgePass = label.new(bar_index, high, "FW geometry pass\nBars: " + str.tostring(patternBars) + "\nWidth: " + str.tostring(startWidthATR, "#.##") + "→" + str.tostring(endWidth / math.max(patternATR, syminfo.mintick), "#.##") + " ATR\nContraction: " + str.tostring(contractionRatio * 100.0, "#.0") + "%\nSlopes: " + str.tostring(upperSlope, "#.###") + " / " + str.tostring(lowerSlope, "#.###") + "\nApex: " + str.tostring(math.round(apexDistance)) + " bars\nPrior: " + f_trendName(wedgeTrend) + " " + str.tostring(math.round(wedgeStrength)) + "\nGeometry: " + str.tostring(math.round(wedgeGeometry)), style = label.style_label_down, color = color.new(color.blue, 55), textcolor = color.white, size = size.tiny)
                f_manageLabel(wedgePass)
        if debugMode and (lowerSlope > upperSlope and upperSlope > 0.0 or upperSlope < lowerSlope and lowerSlope < 0.0) and not wedgeThresholds
            string wedgeReason = patternBars < minWedgeBars ? "bars " + str.tostring(patternBars) + " < " + str.tostring(minWedgeBars) : startWidthATR < minWedgeStartWidthATR ? "width " + str.tostring(startWidthATR, "#.##") + " ATR" : contractionRatio < minWedgeContractionRatio ? "contraction " + str.tostring(contractionRatio * 100.0, "#.0") + "% < " + str.tostring(minWedgeContractionRatio * 100.0, "#.0") + "%" : "apex invalid"
            label wedgeReject = label.new(bar_index, high, "REJECT WEDGE\n" + wedgeReason, style = label.style_label_down, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny)
            f_manageLabel(wedgeReject)

    bool triangleThresholds = patternBars >= minTriangleBars and startWidthATR >= minTriangleStartWidthATR and contractionRatio >= minTriangleContractionRatio
    float triangleGeometry = f_clamp(math.min(patternBars * 1.0 / (minTriangleBars * 2.0), 1.0) * 20.0 + math.min(startWidthATR / (minTriangleStartWidthATR * 2.0), 1.0) * 20.0 + math.min(contractionRatio / 0.60, 1.0) * 40.0 + boundaryQuality * 0.20)
    if fTri and contracting and triangleThresholds and not na(upperSlope) and not na(lowerSlope)
        if math.abs(upperSlope) < flatThreshold and lowerSlope > flatThreshold
            f_offer("Ascending Triangle", "AT", patternStart, patternEnd, TREND_ANY, BREAK_UP, MODE_CONTEXTUAL, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_OPPOSITE_BOUNDARY, na, triangleGeometry, signature)
        if math.abs(lowerSlope) < flatThreshold and upperSlope < -flatThreshold
            f_offer("Descending Triangle", "DTR", patternStart, patternEnd, TREND_ANY, BREAK_DOWN, MODE_CONTEXTUAL, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_OPPOSITE_BOUNDARY, na, triangleGeometry, signature)
        if upperSlope < -flatThreshold and lowerSlope > flatThreshold
            f_offer("Symmetrical Triangle", "ST", patternStart, patternEnd, TREND_ANY, BREAK_BILATERAL, MODE_BILATERAL, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_NONE, na, triangleGeometry, signature)

    float rectangleHeightATR = ((upper1 + upper2) / 2.0 - (lower1 + lower2) / 2.0) / math.max(patternATR, syminfo.mintick)
    bool rectangleTouches = f_pivotType(4) == f_pivotType(2) and f_pivotType(2) == f_pivotType(0)
    if fRect and patternBars >= minRectangleBars and rectangleHeightATR >= minRectangleHeightATR and rectangleTouches and math.abs(upperSlope) < flatThreshold and math.abs(lowerSlope) < flatThreshold and f_equalLevel(upper1, upper2, patternATR) and f_equalLevel(lower1, lower2, patternATR)
        float rectangleDurationPoints = math.min(patternBars * 1.0 / (minRectangleBars * 2.0), 1.0) * 25.0
        float rectangleHeightPoints = math.min(rectangleHeightATR / (minRectangleHeightATR * 2.0), 1.0) * 30.0
        float rectangleBoundaryPoints = boundaryQuality * 0.25
        float touchStructurePoints = rectangleTouches ? 20.0 : 0.0
        float rectangleGeometry = f_clamp(rectangleDurationPoints + rectangleHeightPoints + rectangleBoundaryPoints + touchStructurePoints)
        f_offer("Rectangle", "RECT", patternStart, patternEnd, TREND_ANY, BREAK_BILATERAL, MODE_CONTEXTUAL, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_NONE, na, rectangleGeometry, signature)

    float expansionRatio = startWidth > 0.0 ? (endWidth - startWidth) / startWidth : 0.0
    if fMega and expanding and patternBars >= minMegaphoneBars and startWidthATR >= minMegaphoneStartWidthATR and expansionRatio >= minMegaphoneExpansionRatio and upperSlope > 0.0 and lowerSlope < 0.0
        float megaphoneGeometry = f_clamp(math.min(patternBars * 1.0 / (minMegaphoneBars * 2.0), 1.0) * 20.0 + math.min(startWidthATR / (minMegaphoneStartWidthATR * 2.0), 1.0) * 20.0 + math.min(expansionRatio / 0.60, 1.0) * 45.0 + math.min(math.abs(upperSlope - lowerSlope) / 0.20, 1.0) * 15.0)
        f_offer("Megaphone / Broadening", "MEGA", patternStart, patternEnd, TREND_ANY, BREAK_BILATERAL, MODE_CONTEXTUAL, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_NONE, na, megaphoneGeometry, signature)

    // V geometry uses the actual adjacent b-c and c-d legs, never a-c/c-e.
    if fV
        float leftLeg = f_normalizedSlope(b, c, barB, barC, patternATR)
        float rightLeg = f_normalizedSlope(c, d, barC, barD, patternATR)
        int leftBars = barC - barB
        int rightBars = barD - barC
        float vSymmetry = math.min(leftBars, rightBars) * 1.0 / math.max(leftBars, rightBars)
        float leftAmplitudeATR = math.abs(c - b) / math.max(patternATR, syminfo.mintick)
        float rightAmplitudeATR = math.abs(c - d) / math.max(patternATR, syminfo.mintick)
        bool amplitudeValid = leftAmplitudeATR >= minVLegATR and rightAmplitudeATR >= minVLegATR
        bool vTop = f_pivotType(2) == PIVOT_HIGH and leftLeg > slopeThr * 3.0 and rightLeg < -slopeThr * 3.0 and vSymmetry >= vSymmetryMin and amplitudeValid
        bool vBottom = f_pivotType(2) == PIVOT_LOW and leftLeg < -slopeThr * 3.0 and rightLeg > slopeThr * 3.0 and vSymmetry >= vSymmetryMin and amplitudeValid
        float vGeometry = f_clamp(vSymmetry * 30.0 + math.min(leftAmplitudeATR / 2.0, 1.0) * 25.0 + math.min(rightAmplitudeATR / 2.0, 1.0) * 25.0 + math.min((math.abs(leftLeg) + math.abs(rightLeg)) / 0.30, 1.0) * 20.0)
        if vTop
            float vSupport = math.min(b, d)
            f_offer("V-Top", "VT", barB, barD, TREND_UP, BREAK_DOWN, MODE_REVERSAL, barC, c, barC, c, barB, vSupport, barD, vSupport, INVALID_STATIC, c + f_tolerance(patternATR), vGeometry, signature)
        if vBottom
            float vResistance = math.max(b, d)
            f_offer("V-Bottom", "VB", barB, barD, TREND_DOWN, BREAK_UP, MODE_REVERSAL, barB, vResistance, barD, vResistance, barC, c, barC, c, INVALID_STATIC, c - f_tolerance(patternATR), vGeometry, signature)

    // Curvature families retain chronological quadratic fit and minimum R².
    if fRound
        [curve, curveB, curveC, curveR2, curveCount] = f_curve(patternStart, patternEnd)
        float vertexX = not na(curve) and curve != 0.0 ? -curveB / (2.0 * curve) : na
        float vertexFraction = not na(vertexX) and curveCount > 1 ? vertexX / (curveCount - 1) : na
        bool centralVertex = not na(vertexFraction) and vertexFraction >= vertexMinFraction and vertexFraction <= vertexMaxFraction
        int vertexBar = not na(vertexX) ? patternStart + int(math.round(vertexX)) : patternStart
        float leftCurveSlope = centralVertex ? f_segmentSlope(patternStart, vertexBar, patternATR) : na
        float rightCurveSlope = centralVertex ? f_segmentSlope(vertexBar, patternEnd, patternATR) : na
        [windowHigh, windowLow, rangeValid] = f_windowRange(patternStart, patternEnd)
        int quarterBars = math.max(1, int(math.floor((patternEnd - patternStart + 1) * 0.25)))
        int leftEdgeEnd = patternStart + quarterBars - 1
        int rightEdgeStart = patternEnd - quarterBars + 1
        [leftEdgeHigh, leftEdgeLow, leftEdgeValid] = f_windowRange(patternStart, leftEdgeEnd)
        [centerHigh, centerLow, centerValid] = f_windowRange(leftEdgeEnd + 1, rightEdgeStart - 1)
        [rightEdgeHigh, rightEdgeLow, rightEdgeValid] = f_windowRange(rightEdgeStart, patternEnd)
        float topCenterEdgeATR = leftEdgeValid and centerValid and rightEdgeValid ? math.min(centerHigh - leftEdgeHigh, centerHigh - rightEdgeHigh) / math.max(patternATR, syminfo.mintick) : na
        float bottomCenterEdgeATR = leftEdgeValid and centerValid and rightEdgeValid ? math.min(leftEdgeLow - centerLow, rightEdgeLow - centerLow) / math.max(patternATR, syminfo.mintick) : na
        bool topCenterDominant = not na(topCenterEdgeATR) and topCenterEdgeATR >= minRoundingCenterEdgeATR
        bool bottomCenterDominant = not na(bottomCenterEdgeATR) and bottomCenterEdgeATR >= minRoundingCenterEdgeATR
        float roundingTopHeightATR = rangeValid ? (windowHigh - (f_closeAt(patternStart) + f_closeAt(patternEnd)) / 2.0) / math.max(patternATR, syminfo.mintick) : na
        float roundingBottomDepthATR = rangeValid ? ((f_closeAt(patternStart) + f_closeAt(patternEnd)) / 2.0 - windowLow) / math.max(patternATR, syminfo.mintick) : na
        bool roundedTopBase = not na(curve) and not na(curveR2) and curve < 0.0 and curveR2 >= minR2 and centralVertex and leftCurveSlope > 0.0 and rightCurveSlope < 0.0 and roundingTopHeightATR >= minRoundingHeightATR
        bool roundedBottomBase = not na(curve) and not na(curveR2) and curve > 0.0 and curveR2 >= minR2 and centralVertex and leftCurveSlope < 0.0 and rightCurveSlope > 0.0 and roundingBottomDepthATR >= minRoundingHeightATR
        bool roundedTop = roundedTopBase and topCenterDominant
        bool roundedBottom = roundedBottomBase and bottomCenterDominant
        float vertexPoints = centralVertex ? math.max(0.0, 1.0 - math.abs(vertexFraction - 0.5) / 0.5) * 20.0 : 0.0
        float fitPoints = not na(curveR2) ? math.max(0.0, math.min(1.0, (curveR2 - minR2) / math.max(1.0 - minR2, 0.01))) * 35.0 : 0.0
        float slopeMagnitudePoints = not na(leftCurveSlope) and not na(rightCurveSlope) ? math.min((math.abs(leftCurveSlope) + math.abs(rightCurveSlope)) / math.max(slopeThr * 8.0, 0.0001), 1.0) * 10.0 : 0.0
        float slopeBalancePoints = not na(leftCurveSlope) and not na(rightCurveSlope) ? math.min(math.abs(leftCurveSlope), math.abs(rightCurveSlope)) / math.max(math.max(math.abs(leftCurveSlope), math.abs(rightCurveSlope)), 0.0001) * 10.0 : 0.0
        float slopeConsistencyPoints = slopeMagnitudePoints + slopeBalancePoints
        if roundedTop
            float heightPoints = math.min(roundingTopHeightATR / (minRoundingHeightATR * 2.0), 1.0) * 25.0
            float roundingGeometry = f_clamp(fitPoints + vertexPoints + heightPoints + slopeConsistencyPoints)
            f_offer("Rounding Top", "RT", patternStart, patternEnd, TREND_UP, BREAK_DOWN, MODE_REVERSAL, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_STATIC, windowHigh + f_tolerance(patternATR), roundingGeometry, signature)
        if roundedBottom
            float depthPoints = math.min(roundingBottomDepthATR / (minRoundingHeightATR * 2.0), 1.0) * 25.0
            float roundingGeometry = f_clamp(fitPoints + vertexPoints + depthPoints + slopeConsistencyPoints)
            f_offer("Rounding Bottom", "RB", patternStart, patternEnd, TREND_DOWN, BREAK_UP, MODE_REVERSAL, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_STATIC, windowLow - f_tolerance(patternATR), roundingGeometry, signature)
        if debugMode and roundedTopBase and not topCenterDominant
            label roundingReject = label.new(bar_index, high, "REJECT RT\ncenter dominance " + str.tostring(topCenterEdgeATR, "#.##") + " ATR < " + str.tostring(minRoundingCenterEdgeATR, "#.##"), style = label.style_label_down, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny)
            f_manageLabel(roundingReject)
        if debugMode and roundedBottomBase and not bottomCenterDominant
            label roundingReject = label.new(bar_index, low, "REJECT RB\ncenter dominance " + str.tostring(bottomCenterEdgeATR, "#.##") + " ATR < " + str.tostring(minRoundingCenterEdgeATR, "#.##"), style = label.style_label_up, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny)
            f_manageLabel(roundingReject)

// A Cup candidate is known as soon as left rim, cup low, right rim, and handle
// are confirmed. It does not wait for a later breakout high pivot.
if structuralPivotChanged and fCup and array.size(pivotTypes) >= 4
    float leftRim = f_pivotPrice(3)
    float cupExtreme = f_pivotPrice(2)
    float rightRim = f_pivotPrice(1)
    float handleExtreme = f_pivotPrice(0)
    int leftRimBar = f_pivotBar(3)
    int cupExtremeBar = f_pivotBar(2)
    int rightRimBar = f_pivotBar(1)
    int handleBar = f_pivotBar(0)
    float cupATR = f_pivotATR(0)
    [cupCurve, cupCurveB, cupCurveC, cupR2, cupCount] = f_curve(leftRimBar, rightRimBar)
    float cupVertexX = not na(cupCurve) and cupCurve != 0.0 ? -cupCurveB / (2.0 * cupCurve) : na
    float cupVertexFraction = not na(cupVertexX) and cupCount > 1 ? cupVertexX / (cupCount - 1) : na
    bool cupVertexCentral = not na(cupVertexFraction) and cupVertexFraction >= vertexMinFraction and cupVertexFraction <= vertexMaxFraction
    bool cupRimsSimilar = f_equalLevel(leftRim, rightRim, cupATR)
    float cupDepth = math.abs((leftRim + rightRim) / 2.0 - cupExtreme)
    float handleDepth = math.abs((leftRim + rightRim) / 2.0 - handleExtreme)
    int cupFormationBars = rightRimBar - leftRimBar
    int handleBars = handleBar - rightRimBar
    float maximumHandleBars = cupFormationBars * maxHandleDurationRatio
    bool cupChronologyValid = handleBar > rightRimBar and rightRimBar > cupExtremeBar and cupExtremeBar > leftRimBar
    bool handleDurationValid = cupChronologyValid and cupFormationBars > 0 and handleBars >= minHandleBars and handleBars <= maximumHandleBars
    bool shallowHandle = cupDepth > 0.0 and handleDepth / cupDepth <= maxHandleDepthRatio
    bool bullishShape = f_pivotType(3) == PIVOT_HIGH and f_pivotType(2) == PIVOT_LOW and f_pivotType(1) == PIVOT_HIGH and f_pivotType(0) == PIVOT_LOW
    bool bearishShape = f_pivotType(3) == PIVOT_LOW and f_pivotType(2) == PIVOT_HIGH and f_pivotType(1) == PIVOT_LOW and f_pivotType(0) == PIVOT_HIGH
    bool curveQuality = not na(cupR2) and cupR2 >= (relaxCupCurveFit ? minR2 : math.max(minR2, 0.70)) and cupVertexCentral
    bool bullishCup = bullishShape and handleDurationValid and cupCurve > 0.0 and curveQuality and cupRimsSimilar and cupDepth / math.max(cupATR, syminfo.mintick) >= minRoundingHeightATR and handleExtreme > cupExtreme + cupDepth * 0.60 and shallowHandle
    bool bearishCup = bearishShape and handleDurationValid and cupCurve < 0.0 and curveQuality and cupRimsSimilar and cupDepth / math.max(cupATR, syminfo.mintick) >= minRoundingHeightATR and handleExtreme < cupExtreme - cupDepth * 0.60 and shallowHandle
    float rimAccuracy = f_clamp(1.0 - math.abs(leftRim - rightRim) / math.max(f_tolerance(cupATR), syminfo.mintick))
    float cupFitUnit = not na(cupR2) ? math.max(0.0, math.min(1.0, (cupR2 - minR2) / math.max(1.0 - minR2, 0.01))) : 0.0
    float cupGeometry = f_clamp(rimAccuracy * 25.0 + cupFitUnit * 30.0 + math.min(cupDepth / math.max(cupATR * 2.0, syminfo.mintick), 1.0) * 25.0 + (1.0 - handleDepth / math.max(cupDepth, syminfo.mintick)) * 20.0)
    string cupSignature = str.tostring(leftRimBar) + ":" + str.tostring(cupExtremeBar) + ":" + str.tostring(rightRimBar) + ":" + str.tostring(handleBar)
    if bullishCup
        float rimResistance = math.max(leftRim, rightRim)
        f_offer("Cup and Handle", "CUP", leftRimBar, handleBar, TREND_UP, BREAK_UP, MODE_CONTINUATION, leftRimBar, rimResistance, rightRimBar, rimResistance, handleBar, handleExtreme, handleBar, handleExtreme, INVALID_STATIC, cupExtreme - f_tolerance(cupATR), cupGeometry, cupSignature)
    if bearishCup
        float rimSupport = math.min(leftRim, rightRim)
        f_offer("Inverted Cup and Handle", "ICUP", leftRimBar, handleBar, TREND_DOWN, BREAK_DOWN, MODE_CONTINUATION, handleBar, handleExtreme, handleBar, handleExtreme, leftRimBar, rimSupport, rightRimBar, rimSupport, INVALID_STATIC, cupExtreme + f_tolerance(cupATR), cupGeometry, cupSignature)
    if debugMode and (bullishShape or bearishShape) and not handleDurationValid
        string handleReason = not cupChronologyValid ? "handle chronology invalid" : handleBars < minHandleBars ? "handle duration " + str.tostring(handleBars) + " < " + str.tostring(minHandleBars) : "handle duration " + str.tostring(handleBars) + " > allowed " + str.tostring(maximumHandleBars, "#.##")
        label cupReject = label.new(bar_index, high, "REJECT CUP\n" + handleReason, style = label.style_label_down, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny)
        f_manageLabel(cupReject)

// Flags and pennants need a preceding pivot: pole ends exactly at pattern start,
// while consolidation measurements stop exactly at pattern end.
if structuralPivotChanged and array.size(pivotTypes) >= 6
    int poleStartBar = f_pivotBar(5)
    int consolidationStart = f_pivotBar(4)
    int consolidationEnd = f_pivotBar(0)
    float poleStartPrice = f_pivotPrice(5)
    float poleEndPrice = f_pivotPrice(4)
    float poleATRValue = f_pivotATR(4)
    float poleMove = poleEndPrice - poleStartPrice
    float poleStrength = math.abs(poleMove) / math.max(poleATRValue, syminfo.mintick)
    [consolidationHigh, consolidationLow, consolidationValid] = f_windowRange(consolidationStart, consolidationEnd)
    float consolidationRange = consolidationValid ? consolidationHigh - consolidationLow : na
    bool smallConsolidation = consolidationValid and poleStrength >= minPoleATR and consolidationRange <= math.abs(poleMove) * maxFlagRatio
    bool highSequence = f_pivotType(4) == PIVOT_HIGH
    float upper1 = highSequence ? f_pivotPrice(4) : f_pivotPrice(3)
    float upper2 = highSequence ? f_pivotPrice(0) : f_pivotPrice(1)
    float lower1 = highSequence ? f_pivotPrice(3) : f_pivotPrice(4)
    float lower2 = highSequence ? f_pivotPrice(1) : f_pivotPrice(0)
    int upperBar1 = highSequence ? f_pivotBar(4) : f_pivotBar(3)
    int upperBar2 = highSequence ? f_pivotBar(0) : f_pivotBar(1)
    int lowerBar1 = highSequence ? f_pivotBar(3) : f_pivotBar(4)
    int lowerBar2 = highSequence ? f_pivotBar(1) : f_pivotBar(0)
    float upperSlope = f_normalizedSlope(upper1, upper2, upperBar1, upperBar2, poleATRValue)
    float lowerSlope = f_normalizedSlope(lower1, lower2, lowerBar1, lowerBar2, poleATRValue)
    float startWidth = f_lineValueAt(upperBar1, upper1, upperBar2, upper2, math.max(upperBar1, lowerBar1)) - f_lineValueAt(lowerBar1, lower1, lowerBar2, lower2, math.max(upperBar1, lowerBar1))
    float endWidth = f_lineValueAt(upperBar1, upper1, upperBar2, upper2, math.min(upperBar2, lowerBar2)) - f_lineValueAt(lowerBar1, lower1, lowerBar2, lower2, math.min(upperBar2, lowerBar2))
    bool contracting = endWidth > 0.0 and endWidth < startWidth
    int consolidationBars = consolidationEnd - consolidationStart
    string signature = str.tostring(poleStartBar) + ":" + str.tostring(consolidationStart) + ":" + str.tostring(consolidationEnd)
    float rangeRatio = consolidationRange / math.max(math.abs(poleMove), syminfo.mintick)
    float flagRangeATR = consolidationRange / math.max(poleATRValue, syminfo.mintick)
    float polePoints = math.min(poleStrength / 4.0, 1.0) * 35.0
    float compactPoints = math.max(0.0, 1.0 - rangeRatio / maxFlagRatio) * 30.0
    float parallelPoints = not na(upperSlope) and not na(lowerSlope) ? math.max(0.0, 1.0 - math.abs(upperSlope - lowerSlope) / 0.04) * 25.0 : 0.0
    float durationPoints = math.min(consolidationBars * 1.0 / math.max(minFlagBars * 2.0, 1), 1.0) * 10.0
    float flagGeometry = f_clamp(polePoints + compactPoints + parallelPoints + durationPoints)
    bool flagDurationValid = consolidationBars >= minFlagBars and consolidationBars <= maxFlagBars
    bool flagWidthsPositive = startWidth > 0.0 and endWidth > 0.0
    float flagWidthChangeRatio = flagWidthsPositive ? math.abs(endWidth - startWidth) / math.max(startWidth, syminfo.mintick) : na
    bool flagWidthStable = flagWidthsPositive and flagWidthChangeRatio <= maxFlagWidthChangeRatio
    if fFlag and smallConsolidation and flagRangeATR >= minFlagRangeATR and flagDurationValid and flagWidthStable and not na(upperSlope) and not na(lowerSlope) and math.abs(upperSlope - lowerSlope) < 0.04
        bool bullFlag = poleMove > 0.0 and upperSlope <= 0.025 and lowerSlope <= 0.025 and upperSlope >= -0.20 and lowerSlope >= -0.20
        bool bearFlag = poleMove < 0.0 and upperSlope >= -0.025 and lowerSlope >= -0.025 and upperSlope <= 0.20 and lowerSlope <= 0.20
        if bullFlag
            f_offer("Bullish Flag", "BFLAG", consolidationStart, consolidationEnd, TREND_UP, BREAK_UP, MODE_CONTINUATION, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_OPPOSITE_BOUNDARY, na, flagGeometry, signature)
        if bearFlag
            f_offer("Bearish Flag", "SFLAG", consolidationStart, consolidationEnd, TREND_DOWN, BREAK_DOWN, MODE_CONTINUATION, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_OPPOSITE_BOUNDARY, na, flagGeometry, signature)
    if debugMode and fFlag and smallConsolidation and flagRangeATR < minFlagRangeATR
        label flagReject = label.new(bar_index, high, "REJECT FLAG\nrange " + str.tostring(flagRangeATR, "#.##") + " ATR < " + str.tostring(minFlagRangeATR, "#.##"), style = label.style_label_down, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny)
        f_manageLabel(flagReject)
    if debugMode and fFlag and smallConsolidation and flagRangeATR >= minFlagRangeATR and flagDurationValid and not flagWidthStable
        string flagWidthReason = not flagWidthsPositive ? "channel boundaries crossed" : "width instability " + str.tostring(flagWidthChangeRatio * 100.0, "#.0") + "% > " + str.tostring(maxFlagWidthChangeRatio * 100.0, "#.0") + "%"
        label flagWidthReject = label.new(bar_index, high, "REJECT FLAG\n" + flagWidthReason, style = label.style_label_down, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny)
        f_manageLabel(flagWidthReject)
    float pennantContraction = startWidth > 0.0 ? (startWidth - endWidth) / startWidth : 0.0
    float pennantStartWidthATR = startWidth / math.max(poleATRValue, syminfo.mintick)
    float pennantGeometry = f_clamp(polePoints + compactPoints + math.min(pennantContraction / 0.60, 1.0) * 25.0 + math.min(consolidationBars * 1.0 / math.max(minPennantBars * 2.0, 1), 1.0) * 10.0)
    bool pennantDurationValid = consolidationBars >= minPennantBars and consolidationBars <= maxPennantBars
    bool pennantThresholds = pennantContraction >= minPennantContractionRatio and pennantStartWidthATR >= minPennantStartWidthATR
    if fPennant and smallConsolidation and pennantDurationValid and pennantThresholds and contracting and upperSlope < 0.0 and lowerSlope > 0.0
        if poleMove > 0.0
            f_offer("Bullish Pennant", "BPEN", consolidationStart, consolidationEnd, TREND_UP, BREAK_UP, MODE_CONTINUATION, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_OPPOSITE_BOUNDARY, na, pennantGeometry, signature)
        if poleMove < 0.0
            f_offer("Bearish Pennant", "SPEN", consolidationStart, consolidationEnd, TREND_DOWN, BREAK_DOWN, MODE_CONTINUATION, upperBar1, upper1, upperBar2, upper2, lowerBar1, lower1, lowerBar2, lower2, INVALID_OPPOSITE_BOUNDARY, na, pennantGeometry, signature)
    if debugMode and fPennant and smallConsolidation and pennantDurationValid and contracting and upperSlope < 0.0 and lowerSlope > 0.0 and not pennantThresholds
        string pennantReason = pennantContraction < minPennantContractionRatio ? "contraction " + str.tostring(pennantContraction * 100.0, "#.0") + "% < " + str.tostring(minPennantContractionRatio * 100.0, "#.0") + "%" : "width " + str.tostring(pennantStartWidthATR, "#.##") + " ATR < " + str.tostring(minPennantStartWidthATR, "#.##")
        label pennantReject = label.new(bar_index, high, "REJECT PENNANT\n" + pennantReason, style = label.style_label_down, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny)
        f_manageLabel(pennantReject)

// Diamond: early expansion followed by contraction. Breakout boundaries are the
// two contracting sides, never the midpoint.
if structuralPivotChanged and fDiamond and array.size(pivotTypes) >= 7
    bool startsHigh = f_pivotType(6) == PIVOT_HIGH
    float earlyHigh = startsHigh ? f_pivotPrice(6) : f_pivotPrice(5)
    float earlyLow = startsHigh ? f_pivotPrice(5) : f_pivotPrice(6)
    float middleHigh = startsHigh ? f_pivotPrice(4) : f_pivotPrice(3)
    float middleLow = startsHigh ? f_pivotPrice(3) : f_pivotPrice(4)
    float lateHigh = startsHigh ? f_pivotPrice(2) : f_pivotPrice(1)
    float lateLow = startsHigh ? f_pivotPrice(1) : f_pivotPrice(2)
    int middleHighBar = startsHigh ? f_pivotBar(4) : f_pivotBar(3)
    int middleLowBar = startsHigh ? f_pivotBar(3) : f_pivotBar(4)
    int lateHighBar = startsHigh ? f_pivotBar(2) : f_pivotBar(1)
    int lateLowBar = startsHigh ? f_pivotBar(1) : f_pivotBar(2)
    float earlyWidth = earlyHigh - earlyLow
    float widestWidth = middleHigh - middleLow
    float lateWidth = lateHigh - lateLow
    int finalPivotBar = f_pivotBar(0)
    float finalPivotPrice = f_pivotPrice(0)
    int diamondStart = f_pivotBar(6)
    int diamondEnd = finalPivotBar
    float diamondATR = f_pivotATR(0)
    int diamondBars = diamondEnd - diamondStart
    float widestWidthATR = widestWidth / math.max(diamondATR, syminfo.mintick)
    float projectedFinalUpper = f_lineValueAt(middleHighBar, middleHigh, lateHighBar, lateHigh, finalPivotBar)
    float projectedFinalLower = f_lineValueAt(middleLowBar, middleLow, lateLowBar, lateLow, finalPivotBar)
    float finalProjectedWidth = projectedFinalUpper - projectedFinalLower
    float projectedFinalBoundary = f_pivotType(0) == PIVOT_HIGH ? f_lineValueAt(middleHighBar, middleHigh, lateHighBar, lateHigh, finalPivotBar) : f_lineValueAt(middleLowBar, middleLow, lateLowBar, lateLow, finalPivotBar)
    float diamondTolerance = math.max(syminfo.mintick * minTicks, f_pivotATR(0) * diamondBoundaryToleranceATR)
    bool finalPivotValid = not na(projectedFinalBoundary) and math.abs(finalPivotPrice - projectedFinalBoundary) <= diamondTolerance
    bool finalContractionValid = finalProjectedWidth > 0.0 and finalProjectedWidth <= lateWidth + diamondTolerance * 2.0 and finalProjectedWidth < widestWidth
    bool diamondSizeValid = diamondBars >= minDiamondBars and widestWidthATR >= minDiamondMaxWidthATR
    bool diamondGeometry = earlyWidth > 0.0 and widestWidth > earlyWidth and lateWidth > 0.0 and lateWidth < widestWidth and lateHigh < middleHigh and lateLow > middleLow and finalPivotValid and finalContractionValid and diamondSizeValid
    if diamondGeometry
        float expansionUnit = math.min((widestWidth - earlyWidth) / math.max(earlyWidth, diamondATR) / 0.60, 1.0)
        float contractionUnit = math.min((widestWidth - lateWidth) / math.max(widestWidth, diamondATR) / 0.60, 1.0)
        float boundaryUnit = math.max(0.0, 1.0 - math.abs(finalPivotPrice - projectedFinalBoundary) / math.max(diamondTolerance, syminfo.mintick))
        float diamondQuality = f_clamp(expansionUnit * 35.0 + contractionUnit * 40.0 + boundaryUnit * 25.0)
        string diamondSignature = str.tostring(f_pivotBar(6)) + ":" + str.tostring(f_pivotBar(5)) + ":" + str.tostring(f_pivotBar(4)) + ":" + str.tostring(f_pivotBar(3)) + ":" + str.tostring(f_pivotBar(2)) + ":" + str.tostring(f_pivotBar(1)) + ":" + str.tostring(f_pivotBar(0))
        f_offer("Diamond Top", "DIA-T", diamondStart, diamondEnd, TREND_UP, BREAK_DOWN, MODE_REVERSAL, middleHighBar, middleHigh, lateHighBar, lateHigh, middleLowBar, middleLow, lateLowBar, lateLow, INVALID_OPPOSITE_BOUNDARY, na, diamondQuality, diamondSignature)
        f_offer("Diamond Bottom", "DIA-B", diamondStart, diamondEnd, TREND_DOWN, BREAK_UP, MODE_REVERSAL, middleHighBar, middleHigh, lateHighBar, lateHigh, middleLowBar, middleLow, lateLowBar, lateLow, INVALID_OPPOSITE_BOUNDARY, na, diamondQuality, diamondSignature)
        f_offer("Bullish Continuation Diamond", "DIA-CU", diamondStart, diamondEnd, TREND_UP, BREAK_UP, MODE_CONTINUATION, middleHighBar, middleHigh, lateHighBar, lateHigh, middleLowBar, middleLow, lateLowBar, lateLow, INVALID_OPPOSITE_BOUNDARY, na, diamondQuality, diamondSignature)
        f_offer("Bearish Continuation Diamond", "DIA-CD", diamondStart, diamondEnd, TREND_DOWN, BREAK_DOWN, MODE_CONTINUATION, middleHighBar, middleHigh, lateHighBar, lateHigh, middleLowBar, middleLow, lateLowBar, lateLow, INVALID_OPPOSITE_BOUNDARY, na, diamondQuality, diamondSignature)
    if debugMode and earlyWidth > 0.0 and widestWidth > earlyWidth and lateWidth > 0.0 and lateWidth < widestWidth and finalPivotValid and finalContractionValid and not diamondSizeValid
        string diamondReason = diamondBars < minDiamondBars ? "bars " + str.tostring(diamondBars) + " < " + str.tostring(minDiamondBars) : "width " + str.tostring(widestWidthATR, "#.##") + " ATR < " + str.tostring(minDiamondMaxWidthATR, "#.##")
        label diamondReject = label.new(bar_index, high, "REJECT DIAMOND\n" + diamondReason, style = label.style_label_down, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny)
        f_manageLabel(diamondReject)

// Bump-and-run: bounded chronological regressions compare a lead-in segment to
// an accelerated bump segment. The projected lead-in reference confirms run.
if structuralPivotChanged and fBump and array.size(pivotTypes) >= 7
    int leadStart = f_pivotBar(6)
    int leadEnd = f_pivotBar(4)
    int bumpEnd = f_pivotBar(2)
    int runEnd = f_pivotBar(0)
    float bumpATR = f_pivotATR(0)
    float leadSlope = f_segmentSlope(leadStart, leadEnd, bumpATR)
    float bumpSlope = f_segmentSlope(leadEnd, bumpEnd, bumpATR)
    float leadStartPrice = f_closeAt(leadStart)
    float leadEndPrice = f_closeAt(leadEnd)
    bool historyValid = not na(leadSlope) and not na(bumpSlope) and not na(leadStartPrice) and not na(leadEndPrice)
    string bumpSignature = str.tostring(leadStart) + ":" + str.tostring(leadEnd) + ":" + str.tostring(bumpEnd) + ":" + str.tostring(runEnd)
    float accelerationQuality = historyValid and leadSlope != 0.0 ? math.min(math.abs(bumpSlope / leadSlope) / (accelerationMultiplier * 2.0), 1.0) * 55.0 : 0.0
    float leadQuality = historyValid ? math.min(math.abs(leadSlope) / 0.10, 1.0) * 25.0 : 0.0
    float bumpDurationQuality = math.min((bumpEnd - leadEnd) * 1.0 / 20.0, 1.0) * 20.0
    float bumpGeometry = f_clamp(accelerationQuality + leadQuality + bumpDurationQuality)
    if historyValid and leadSlope > 0.0 and bumpSlope > leadSlope and math.abs(bumpSlope) >= math.abs(leadSlope) * accelerationMultiplier
        f_offer("Bump and Run Top", "BRT", leadStart, runEnd, TREND_UP, BREAK_DOWN, MODE_REVERSAL, leadStart, leadStartPrice, leadEnd, leadEndPrice, leadStart, leadStartPrice, leadEnd, leadEndPrice, INVALID_STATIC, f_pivotPrice(2) + f_tolerance(bumpATR), bumpGeometry, bumpSignature)
    if historyValid and leadSlope < 0.0 and bumpSlope < leadSlope and math.abs(bumpSlope) >= math.abs(leadSlope) * accelerationMultiplier
        f_offer("Bump and Run Bottom", "BRB", leadStart, runEnd, TREND_DOWN, BREAK_UP, MODE_REVERSAL, leadStart, leadStartPrice, leadEnd, leadEndPrice, leadStart, leadStartPrice, leadEnd, leadEndPrice, INVALID_STATIC, f_pivotPrice(2) - f_tolerance(bumpATR), bumpGeometry, bumpSignature)

// Candidate lifecycle ---------------------------------------------------------
if barstate.isconfirmed and array.size(candidates) > 0
    activeCount := 0
    float bestQualityThisBar = na
    float bestGeometryThisBar = na
    float bestBreakoutThisBar = na
    int bestCodeOrderThisBar = 999
    for index = 0 to array.size(candidates) - 1
        PatternCandidate candidate = array.get(candidates, index)
        if candidate.status == STATUS_FORMING
            int age = bar_index - candidate.knowledgeBar
            float upperBoundary = f_boundaryUpper(candidate, bar_index)
            float lowerBoundary = f_boundaryLower(candidate, bar_index)
            bool apexPassed = candidate.expiresAtBoundaryCross and not na(upperBoundary) and not na(lowerBoundary) and upperBoundary <= lowerBoundary
            float bullishPrice = requireClose ? close : high
            float bearishPrice = requireClose ? close : low
            bool bullishBreak = not na(upperBoundary) and bullishPrice > upperBoundary + breakoutBuffer
            bool bearishBreak = not na(lowerBoundary) and bearishPrice < lowerBoundary - breakoutBuffer
            bool ambiguousBreakout = candidate.expectedBreakout == BREAK_BILATERAL and bullishBreak and bearishBreak
            int direction = ambiguousBreakout ? 0 : candidate.expectedBreakout == BREAK_UP and bullishBreak ? BREAK_UP : candidate.expectedBreakout == BREAK_DOWN and bearishBreak ? BREAK_DOWN : candidate.expectedBreakout == BREAK_BILATERAL and bullishBreak ? BREAK_UP : candidate.expectedBreakout == BREAK_BILATERAL and bearishBreak ? BREAK_DOWN : 0
            float bullishInvalidationPrice = invalidationMode == "Wick" ? low : close
            float bearishInvalidationPrice = invalidationMode == "Wick" ? high : close
            bool staticFailure = candidate.invalidMode == INVALID_STATIC and not na(candidate.invalidLevel) and (candidate.expectedBreakout == BREAK_UP ? bullishInvalidationPrice < candidate.invalidLevel : candidate.expectedBreakout == BREAK_DOWN ? bearishInvalidationPrice > candidate.invalidLevel : false)
            bool boundaryFailure = candidate.invalidMode == INVALID_OPPOSITE_BOUNDARY and (candidate.expectedBreakout == BREAK_UP ? not na(lowerBoundary) and bullishInvalidationPrice < lowerBoundary - breakoutBuffer : candidate.expectedBreakout == BREAK_DOWN ? not na(upperBoundary) and bearishInvalidationPrice > upperBoundary + breakoutBuffer : false)
            bool expiredByAge = age > maxAge
            bool expired = expiredByAge or apexPassed
            bool invalidated = staticFailure or boundaryFailure
            bool sameBarConflict = invalidated and direction != 0
            float breakoutLevel = direction == BREAK_UP ? upperBoundary : direction == BREAK_DOWN ? lowerBoundary : na
            float breakoutStrength = direction == 0 or na(breakoutLevel) ? 0.0 : math.abs(close - breakoutLevel) / math.max(atr, syminfo.mintick)
            bool strengthAccepted = not useBreakStrength or breakoutStrength >= minBreakATR
            // Structural invalidation always wins over a same-bar breakout.
            if invalidated or expired
                candidate.status := expired ? STATUS_EXPIRED : STATUS_FAILED
                f_deleteForming(candidate)
                if debugMode
                    string failureReason = apexPassed ? "pattern apex passed" : sameBarConflict ? "same-bar structural invalidation" : expiredByAge ? "expired" : "structural invalidation (" + invalidationMode + ")"
                    string failurePrefix = apexPassed ? "EXPIRE " : "FAILED "
                    label failedLabel = label.new(bar_index, close, failurePrefix + candidate.code + "\n" + failureReason, color = color.new(color.red, 55), textcolor = color.white, size = size.tiny)
                    f_manageLabel(failedLabel)
            else if ambiguousBreakout
                activeCount += 1
                if debugMode
                    label ambiguousLabel = label.new(bar_index, close, "AMBIGUOUS " + candidate.code + "\nboth breakout boundaries satisfied", color = color.new(color.orange, 55), textcolor = color.white, size = size.tiny)
                    f_manageLabel(ambiguousLabel)
            else if direction != 0 and strengthAccepted
                candidate.status := STATUS_CONFIRMED_INTERNAL
                f_deleteForming(candidate)
                float breakoutScore = math.min(breakoutStrength / 0.50, 1.0) * 100.0
                float quality = f_clamp(candidate.geometryScore * 0.50 + candidate.contextScore * 0.20 + breakoutScore * 0.30)
                bool finalQualityAccepted = quality >= minFinalQuality or showLow
                if not finalQualityAccepted
                    candidate.status := STATUS_CONFIRMED_SUPPRESSED
                    if debugMode
                        label finalQualityDebug = label.new(bar_index, close, "SUPPRESS " + candidate.code + "\nfinal quality " + str.tostring(math.round(quality)) + " < " + str.tostring(minFinalQuality), color = color.new(color.purple, 55), textcolor = color.white, size = size.tiny)
                        f_manageLabel(finalQualityDebug)
                else
                    int clusterIndex = -1
                    if array.size(displayedPatterns) > 0
                        for displayIndex = 0 to array.size(displayedPatterns) - 1
                            DisplayedPattern displayed = array.get(displayedPatterns, displayIndex)
                            if f_clusterMatch(displayed, candidate, direction, bar_index, upperBoundary, lowerBoundary)
                                clusterIndex := displayIndex
                    if clusterIndex >= 0
                        // First-confirmed-wins: never delete or rewrite the historical event.
                        candidate.status := STATUS_CONFIRMED_SUPPRESSED
                        if debugMode
                            label clusterDebug = label.new(bar_index, close, "SUPPRESS " + candidate.code + "\nconfirmed cluster already emitted\nfirst-confirmed-wins", color = color.new(color.purple, 55), textcolor = color.white, size = size.tiny)
                            f_manageLabel(clusterDebug)
                    else
                        candidate.status := STATUS_CONFIRMED_EMITTED
                        string deterministicID = candidate.code + "-" + str.tostring(candidate.startBar) + "-" + str.tostring(bar_index)
                        array.push(emittedIDs, deterministicID)
                        while array.size(emittedIDs) > 100
                            array.shift(emittedIDs)
                        serial += 1
                        confirmedEventCounter += 1
                        string classification = f_classification(candidate, direction)
                        int codeOrder = f_codeOrder(candidate.code)
                        bool dashboardWinner = na(bestQualityThisBar) or quality > bestQualityThisBar or quality == bestQualityThisBar and candidate.geometryScore > bestGeometryThisBar or quality == bestQualityThisBar and candidate.geometryScore == bestGeometryThisBar and breakoutScore > bestBreakoutThisBar or quality == bestQualityThisBar and candidate.geometryScore == bestGeometryThisBar and breakoutScore == bestBreakoutThisBar and codeOrder < bestCodeOrderThisBar
                        if dashboardWinner
                            bestQualityThisBar := quality
                            bestGeometryThisBar := candidate.geometryScore
                            bestBreakoutThisBar := breakoutScore
                            bestCodeOrderThisBar := codeOrder
                            latestName := candidate.name
                            latestClass := classification
                            latestStatus := "CONFIRMED"
                            latestTrend := f_trendName(candidate.priorTrend)
                            latestID := deterministicID
                            latestQuality := quality
                            latestLevel := breakoutLevel
                            latestATR := atr
                            latestStrength := candidate.priorStrength
                            latestGeometryScore := candidate.geometryScore
                            latestContextScore := candidate.contextScore
                            latestBreakoutScore := breakoutScore
                            latestPatternBars := candidate.endBar - candidate.startBar
                            latestPriorStructureComponent := candidate.priorStructureComponent
                            latestPriorSlopeComponent := candidate.priorSlopeComponent
                            latestPriorEMAComponent := candidate.priorEMAComponent
                            latestPriorPersistenceComponent := candidate.priorPersistenceComponent
                        label confirmedLabel = na
                        line upperDrawing = na
                        line lowerDrawing = na
                        line necklineDrawing = na
                        line breakoutDrawing = na
                        if showConfirmed and showLabels
                            confirmedLabel := label.new(bar_index, direction == BREAK_UP ? low : high, candidate.code + " #" + str.tostring(serial) + "\n" + str.replace_all(classification, "_", " ") + "\nQ:" + str.tostring(math.round(quality)) + " T:" + f_trendName(candidate.priorTrend) + " " + str.tostring(math.round(candidate.priorStrength)), style = direction == BREAK_UP ? label.style_label_up : label.style_label_down, color = direction == BREAK_UP ? color.new(color.lime, 10) : color.new(color.red, 10), textcolor = color.white, size = size.tiny)
                            f_manageLabel(confirmedLabel)
                        bool hnsPattern = candidate.code == "HNS" or candidate.code == "IHNS"
                        bool staticNeckPattern = candidate.code == "DT" or candidate.code == "DB" or candidate.code == "TT" or candidate.code == "TB"
                        bool drawThisPattern = drawingMode != "Latest Only" or dashboardWinner
                        if drawingMode == "Latest Only" and dashboardWinner and array.size(displayedPatterns) > 0
                            for priorDrawingIndex = 0 to array.size(displayedPatterns) - 1
                                DisplayedPattern priorDisplay = array.get(displayedPatterns, priorDrawingIndex)
                                f_deletePatternDrawings(priorDisplay)
                        if drawThisPattern and showLines and not hnsPattern
                            if not na(candidate.upperPrice1) and not na(candidate.upperPrice2)
                                upperDrawing := line.new(candidate.upperBar1, candidate.upperPrice1, bar_index, upperBoundary, color = color.new(color.red, 30))
                            if not na(candidate.lowerPrice1) and not na(candidate.lowerPrice2)
                                lowerDrawing := line.new(candidate.lowerBar1, candidate.lowerPrice1, bar_index, lowerBoundary, color = color.new(color.lime, 30))
                        if drawThisPattern and showNeck and (hnsPattern or staticNeckPattern)
                            bool bearishNeckline = candidate.code == "HNS" or candidate.code == "DT" or candidate.code == "TT"
                            int neckBar1 = bearishNeckline ? candidate.lowerBar1 : candidate.upperBar1
                            float neckPrice1 = bearishNeckline ? candidate.lowerPrice1 : candidate.upperPrice1
                            float neckAtBreakout = bearishNeckline ? lowerBoundary : upperBoundary
                            necklineDrawing := line.new(neckBar1, neckPrice1, bar_index, neckAtBreakout, color = color.new(color.yellow, 20))
                        if drawThisPattern and showBreak
                            breakoutDrawing := line.new(math.max(candidate.endBar, bar_index - 1), breakoutLevel, bar_index + 1, breakoutLevel, color = direction == BREAK_UP ? color.lime : color.red, style = line.style_dashed)
                        DisplayedPattern newDisplay = DisplayedPattern.new(candidate.code, direction, candidate.priorTrend, candidate.startBar, candidate.endBar, bar_index, quality, upperBoundary, lowerBoundary, atr, f_tolerance(atr), confirmedLabel, upperDrawing, lowerDrawing, necklineDrawing, breakoutDrawing)
                        array.push(displayedPatterns, newDisplay)
                        if drawingMode != "Latest Only"
                            f_applyDrawingRetention()
                        if debugMode
                            label scoreDebug = label.new(bar_index, close, candidate.code + " CONFIRMED\nGeometry: " + str.tostring(math.round(candidate.geometryScore)) + "\nContext: " + str.tostring(math.round(candidate.contextScore)) + "\nBreakout: " + str.tostring(math.round(breakoutScore)) + "\nFinal: " + str.tostring(math.round(quality)), color = color.new(color.blue, 55), textcolor = color.white, size = size.tiny)
                            f_manageLabel(scoreDebug)
            else
                activeCount += 1

// Dashboard -------------------------------------------------------------------
var table dashboard = table.new(position.top_right, 2, 18, border_width = 1)
if barstate.islast and showDash
    table.cell(dashboard, 0, 0, "LATEST PATTERN", bgcolor = color.rgb(35, 45, 60), text_color = color.white)
    table.cell(dashboard, 1, 0, "", bgcolor = color.rgb(35, 45, 60))
    table.cell(dashboard, 0, 1, "Pattern")
    table.cell(dashboard, 1, 1, latestName)
    table.cell(dashboard, 0, 2, "Class")
    table.cell(dashboard, 1, 2, str.replace_all(latestClass, "_", " "))
    table.cell(dashboard, 0, 3, "Status")
    table.cell(dashboard, 1, 3, latestStatus)
    table.cell(dashboard, 0, 4, "Prior Trend")
    table.cell(dashboard, 1, 4, latestTrend)
    table.cell(dashboard, 0, 5, "Trend Strength")
    table.cell(dashboard, 1, 5, na(latestStrength) ? "—" : str.tostring(math.round(latestStrength)))
    table.cell(dashboard, 0, 6, "Quality")
    table.cell(dashboard, 1, 6, na(latestQuality) ? "—" : str.tostring(math.round(latestQuality)))
    table.cell(dashboard, 0, 7, "Breakout / ATR")
    table.cell(dashboard, 1, 7, na(latestLevel) ? "—" : str.tostring(latestLevel, format.mintick) + " / " + str.tostring(latestATR, format.mintick))
    table.cell(dashboard, 0, 8, "ID")
    table.cell(dashboard, 1, 8, latestID)
    table.cell(dashboard, 0, 9, "Active forming")
    table.cell(dashboard, 1, 9, str.tostring(activeCount))
    if debugMode
        table.cell(dashboard, 0, 10, "Geometry")
        table.cell(dashboard, 1, 10, na(latestGeometryScore) ? "—" : str.tostring(math.round(latestGeometryScore)))
        table.cell(dashboard, 0, 11, "Context")
        table.cell(dashboard, 1, 11, na(latestContextScore) ? "—" : str.tostring(math.round(latestContextScore)))
        table.cell(dashboard, 0, 12, "Breakout")
        table.cell(dashboard, 1, 12, na(latestBreakoutScore) ? "—" : str.tostring(math.round(latestBreakoutScore)))
        table.cell(dashboard, 0, 13, "Pattern bars")
        table.cell(dashboard, 1, 13, na(latestPatternBars) ? "—" : str.tostring(latestPatternBars))
        table.cell(dashboard, 0, 14, "Trend structure")
        table.cell(dashboard, 1, 14, na(latestPriorStructureComponent) ? "—" : str.tostring(math.round(latestPriorStructureComponent)))
        table.cell(dashboard, 0, 15, "Trend slope")
        table.cell(dashboard, 1, 15, na(latestPriorSlopeComponent) ? "—" : str.tostring(math.round(latestPriorSlopeComponent)))
        table.cell(dashboard, 0, 16, "Trend EMA")
        table.cell(dashboard, 1, 16, na(latestPriorEMAComponent) ? "—" : str.tostring(math.round(latestPriorEMAComponent)))
        table.cell(dashboard, 0, 17, "Trend persistence")
        table.cell(dashboard, 1, 17, na(latestPriorPersistenceComponent) ? "—" : str.tostring(math.round(latestPriorPersistenceComponent)))

bool newConfirmedPattern = confirmedEventCounter > confirmedEventCounter[1]
alertcondition(newConfirmedPattern, "New confirmed pattern", "A new FCPO Core Chart Pattern has confirmed.")
